+++ b/src/screening/seadrop.ts
@@ -0,0 +1,92 @@
+import { encodeFunctionData, getAddress, parseAbi, type PublicClient } from 'viem';
+import type { Address, Hex } from '../types';
+
+/** Canonical SeaDrop 1.0, same address on every chain OpenSea deployed it to. */
+export const SEADROP: Address = getAddress('0x00005EA00Ac477B1030CE78506496e8C2dE24bf5');
+
+/** OpenSea's fee recipient, used when a drop restricts recipients. */
+const OPENSEA_FEE_RECIPIENT: Address = getAddress('0x0000a26b00c1F0DF003000390027140000fAa719');
+
+const SEADROP_ABI = parseAbi([
+  'struct PublicDrop { uint80 mintPrice; uint48 startTime; uint48 endTime; uint16 maxTotalMintableByWallet; uint16 feeBps; bool restrictFeeRecipients; }',
+  'function getPublicDrop(address nftContract) view returns (PublicDrop)',
+  'function getAllowedFeeRecipients(address nftContract) view returns (address[])',
+  'function mintPublic(address nftContract, address feeRecipient, address minterIfNotPayer, uint256 quantity) payable',
+]);
+
+export interface PublicDropInfo {
+  mintPrice: bigint;
+  startTime: number;
+  endTime: number;
+  maxTotalMintableByWallet: number;
+  restrictFeeRecipients: boolean;
+}
+
+/**
+ * OpenSea's own drop mechanism (SeaDrop) keeps mint config in a separate
+ * contract, so a collection using it exposes no `mint()` of its own. Reading
+ * the drop tells us the price and the live window directly, which is stronger
+ * evidence than probing.
+ */
+export async function readPublicDrop(
+  client: PublicClient,
+  nft: Address,
+): Promise<PublicDropInfo | undefined> {
+  try {
+    const drop = await client.readContract({
+      address: SEADROP,
+      abi: SEADROP_ABI,
+      functionName: 'getPublicDrop',
+      args: [nft],
+    });
+    // An unconfigured drop reads back as all zeros.
+    if (drop.startTime === 0 && drop.endTime === 0) return undefined;
+    return {
+      mintPrice: drop.mintPrice,
+      startTime: Number(drop.startTime),
+      endTime: Number(drop.endTime),
+      maxTotalMintableByWallet: Number(drop.maxTotalMintableByWallet),
+      restrictFeeRecipients: drop.restrictFeeRecipients,
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+export function isDropLive(drop: PublicDropInfo, nowSeconds = Math.floor(Date.now() / 1000)): boolean {
+  return nowSeconds >= drop.startTime && nowSeconds <= drop.endTime;
+}
+
+async function pickFeeRecipient(client: PublicClient, nft: Address): Promise<Address> {
+  try {
+    const allowed = await client.readContract({
+      address: SEADROP,
+      abi: SEADROP_ABI,
+      functionName: 'getAllowedFeeRecipients',
+      args: [nft],
+    });
+    const first = allowed[0];
+    if (first) return getAddress(first);
+  } catch {
+    // fall through
+  }
+  return OPENSEA_FEE_RECIPIENT;
+}
+
+export async function buildSeadropCall(
+  client: PublicClient,
+  nft: Address,
+  minter: Address,
+  quantity: number,
+): Promise<{ to: Address; data: Hex }> {
+  const feeRecipient = await pickFeeRecipient(client, nft);
+  return {
+    to: SEADROP,
+    data: encodeFunctionData({
+      abi: SEADROP_ABI,
+      functionName: 'mintPublic',
+      // minterIfNotPayer == minter: we pay for our own mint.
+      args: [nft, feeRecipient, minter, BigInt(quantity)],
+    }),
+  };
+}
diff --git a/src/state/store.ts b/src/state/store.ts
new file mode 100644
index 0000000..ba996a2
--- /dev/null
+++ b/src/state/store.ts
@@ -0,0 +1,114 @@
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import type { Address, AttemptRecord } from '../types';
+
+interface StateFile {
+  version: 1;
+  /** "<chainId>:<lowercased address>" -> what happened. */
+  attempts: Record<string, AttemptRecord>;
+  /** "<YYYY-MM-DD>:<chainId>" -> wei spent, decimal string. */
+  spend: Record<string, string>;
+  /** chainId -> last block scanned by the on-chain discovery adapter. */
+  cursors: Record<string, string>;
+}
+
+const EMPTY: StateFile = { version: 1, attempts: {}, spend: {}, cursors: {} };
+
+export function attemptKey(chainId: number, contract: Address): string {
+  return `${chainId}:${contract.toLowerCase()}`;
+}
+
+function dayKey(chainId: number, at: Date): string {
+  return `${at.toISOString().slice(0, 10)}:${chainId}`;
+}
+
+/**
+ * Tiny JSON-backed store. Writes go to a temp file then rename, so a crash
+ * mid-write can't leave a truncated state file behind.
+ */
+export class Store {
+  private data: StateFile;
+
+  private constructor(
+    private readonly path: string,
+    data: StateFile,
+  ) {
+    this.data = data;
+  }
+
+  static open(path: string, cwd = process.cwd()): Store {
+    const abs = resolve(cwd, path);
+    if (!existsSync(abs)) return new Store(abs, structuredClone(EMPTY));
+    try {
+      const parsed = JSON.parse(readFileSync(abs, 'utf8')) as Partial<StateFile>;
+      return new Store(abs, {
+        version: 1,
+        attempts: parsed.attempts ?? {},
+        spend: parsed.spend ?? {},
+        cursors: parsed.cursors ?? {},
+      });
+    } catch {
+      // A corrupt state file should not stop the bot; worst case we re-scan.
+      return new Store(abs, structuredClone(EMPTY));
+    }
+  }
+
+  flush(): void {
+    mkdirSync(dirname(this.path), { recursive: true });
+    const tmp = `${this.path}.tmp`;
+    writeFileSync(tmp, `${JSON.stringify(this.data, null, 2)}\n`, 'utf8');
+    renameSync(tmp, this.path);
+  }
+
+  getAttempt(chainId: number, contract: Address): AttemptRecord | undefined {
+    return this.data.attempts[attemptKey(chainId, contract)];
+  }
+
+  /**
+   * True once we've reached a verdict we don't want to revisit. Transient
+   * failures are left open so the next pass can retry them.
+   */
+  isSettled(chainId: number, contract: Address): boolean {
+    const rec = this.getAttempt(chainId, contract);
+    if (!rec) return false;
+    return rec.status === 'minted' || rec.status === 'dry-run' || rec.status === 'rejected';
+  }
+
+  recordAttempt(chainId: number, contract: Address, record: AttemptRecord): void {
+    this.data.attempts[attemptKey(chainId, contract)] = record;
+  }
+
+  spentToday(chainId: number, now = new Date()): bigint {
+    return BigInt(this.data.spend[dayKey(chainId, now)] ?? '0');
+  }
+
+  addSpend(chainId: number, wei: bigint, now = new Date()): void {
+    const key = dayKey(chainId, now);
+    this.data.spend[key] = (BigInt(this.data.spend[key] ?? '0') + wei).toString();
+  }
+
+  getCursor(chainId: number): bigint | undefined {
+    const raw = this.data.cursors[String(chainId)];
+    return raw === undefined ? undefined : BigInt(raw);
+  }
+
+  setCursor(chainId: number, block: bigint): void {
+    this.data.cursors[String(chainId)] = block.toString();
+  }
+
+  summary(): {
+    attempts: number;
+    byStatus: Record<string, number>;
+    spend: Record<string, string>;
+  } {
+    const byStatus: Record<string, number> = {};
+    for (const rec of Object.values(this.data.attempts)) {
+      byStatus[rec.status] = (byStatus[rec.status] ?? 0) + 1;
+    }
+    return {
+      attempts: Object.keys(this.data.attempts).length,
+      byStatus,
+      spend: { ...this.data.spend },
+    };
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..7da6533
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,69 @@
+import type { Address, Hex } from 'viem';
+
+export type { Address, Hex };
+
+export type DiscoverySource = 'opensea' | 'onchain' | 'manual';
+
+/** A contract we might want to mint from, before any screening has happened. */
+export interface Candidate {
+  chainId: number;
+  contract: Address;
+  source: DiscoverySource;
+  /** ms epoch when we first saw it. */
+  discoveredAt: number;
+  name?: string;
+  openseaSlug?: string;
+  /** ms epoch the collection/contract went live, when the source tells us. */
+  liveAt?: number;
+}
+
+export type TokenStandard = 'erc721' | 'erc1155' | 'unknown';
+
+export interface ContractInfo {
+  standard: TokenStandard;
+  name?: string;
+  symbol?: string;
+  totalSupply?: bigint;
+}
+
+/**
+ * A concrete, simulated-successful way to mint. `value` is always 0n — this
+ * system only ever mints things that are actually free.
+ */
+export interface MintPlan {
+  /** Human-readable route, e.g. "mint(uint256)" or "SeaDrop.mintPublic". */
+  label: string;
+  /** Contract we send the transaction to (not always the NFT contract). */
+  to: Address;
+  data: Hex;
+  value: 0n;
+  quantity: number;
+  /** Gas units from estimateGas, before any buffer. */
+  gasEstimate: bigint;
+}
+
+export interface ScreenResult {
+  candidate: Candidate;
+  info: ContractInfo;
+  /** Non-empty means we are not minting. Each entry is a human-readable reason. */
+  rejections: string[];
+  plan?: MintPlan;
+}
+
+export type AttemptStatus =
+  | 'minted'
+  | 'dry-run'
+  | 'rejected'
+  | 'failed'
+  | 'skipped';
+
+export interface AttemptRecord {
+  status: AttemptStatus;
+  /** ms epoch. */
+  at: number;
+  label?: string;
+  txHash?: Hex;
+  /** Actual gas spent, wei, as a decimal string. */
+  gasCostWei?: string;
+  reason?: string;
+}
diff --git a/tests/budget.test.ts b/tests/budget.test.ts
new file mode 100644
index 0000000..579cb1a
--- /dev/null
+++ b/tests/budget.test.ts
@@ -0,0 +1,77 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { checkGasBudget, killSwitchEngaged } from '../src/budget';
+import type { ChainConfig } from '../src/config';
+import { Store } from '../src/state/store';
+
+const CHAIN: ChainConfig = {
+  id: 8453,
+  name: 'base',
+  rpcUrl: 'https://mainnet.base.org',
+  enabled: true,
+  nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
+  maxGasCostWei: 1_000n,
+  dailyGasBudgetWei: 2_500n,
+};
+
+function freshStore(): Store {
+  const dir = mkdtempSync(join(tmpdir(), 'automint-budget-'));
+  return Store.open('state.json', dir);
+}
+
+describe('checkGasBudget', () => {
+  it('allows a mint inside both ceilings', () => {
+    expect(checkGasBudget(freshStore(), CHAIN, 900n).allowed).toBe(true);
+  });
+
+  it('allows a mint exactly at the per-mint cap', () => {
+    expect(checkGasBudget(freshStore(), CHAIN, 1_000n).allowed).toBe(true);
+  });
+
+  it('rejects a single mint above the per-mint cap', () => {
+    const verdict = checkGasBudget(freshStore(), CHAIN, 1_001n);
+    expect(verdict.allowed).toBe(false);
+    expect(verdict.reason).toContain('per-mint cap');
+  });
+
+  it('rejects once the day total would be exceeded', () => {
+    const store = freshStore();
+    const now = new Date('2026-07-29T00:00:00Z');
+    store.addSpend(CHAIN.id, 2_000n, now);
+
+    // 2000 already spent, cap 2500: 500 fits, 501 does not.
+    expect(checkGasBudget(store, CHAIN, 500n, now).allowed).toBe(true);
+    const verdict = checkGasBudget(store, CHAIN, 501n, now);
+    expect(verdict.allowed).toBe(false);
+    expect(verdict.reason).toContain('daily gas budget');
+  });
+
+  it('resets the daily allowance on the next UTC day', () => {
+    const store = freshStore();
+    store.addSpend(CHAIN.id, 2_500n, new Date('2026-07-29T23:59:00Z'));
+    expect(checkGasBudget(store, CHAIN, 900n, new Date('2026-07-29T23:59:00Z')).allowed).toBe(false);
+    expect(checkGasBudget(store, CHAIN, 900n, new Date('2026-07-30T00:01:00Z')).allowed).toBe(true);
+  });
+
+  it('does not let spend on one chain block another', () => {
+    const store = freshStore();
+    const now = new Date('2026-07-29T00:00:00Z');
+    store.addSpend(1, 2_500n, now);
+    expect(checkGasBudget(store, CHAIN, 900n, now).allowed).toBe(true);
+  });
+});
+
+describe('killSwitchEngaged', () => {
+  it('is false when the file is absent and true once it appears', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'automint-kill-'));
+    try {
+      expect(killSwitchEngaged('STOP', dir)).toBe(false);
+      writeFileSync(join(dir, 'STOP'), '', 'utf8');
+      expect(killSwitchEngaged('STOP', dir)).toBe(true);
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/tests/config.test.ts b/tests/config.test.ts
