index 0000000..8509401
--- /dev/null
+++ b/src/screening/interfaces.ts
@@ -0,0 +1,87 @@
+import { parseAbi, type PublicClient } from 'viem';
+import type { Address, ContractInfo, TokenStandard } from '../types';
+
+const ERC165_ABI = parseAbi([
+  'function supportsInterface(bytes4 interfaceId) view returns (bool)',
+]);
+
+const METADATA_ABI = parseAbi([
+  'function name() view returns (string)',
+  'function symbol() view returns (string)',
+  'function totalSupply() view returns (uint256)',
+  'function balanceOf(address owner) view returns (uint256)',
+]);
+
+const INTERFACE_ID_ERC721 = '0x80ac58cd';
+const INTERFACE_ID_ERC1155 = '0xd9b67a26';
+
+async function supports(
+  client: PublicClient,
+  address: Address,
+  interfaceId: `0x${string}`,
+): Promise<boolean> {
+  try {
+    return await client.readContract({
+      address,
+      abi: ERC165_ABI,
+      functionName: 'supportsInterface',
+      args: [interfaceId],
+    });
+  } catch {
+    // No ERC-165, reverting fallback, or a non-contract address.
+    return false;
+  }
+}
+
+async function tryRead<T>(fn: () => Promise<T>): Promise<T | undefined> {
+  try {
+    return await fn();
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * ERC-165 first, then a behavioural fallback: plenty of real collections ship
+ * a broken or missing `supportsInterface`, but a contract that answers
+ * `balanceOf(address)` and has bytecode is still worth screening.
+ */
+export async function inspectContract(
+  client: PublicClient,
+  address: Address,
+): Promise<ContractInfo & { hasCode: boolean }> {
+  const code = await tryRead(() => client.getCode({ address }));
+  const hasCode = !!code && code !== '0x';
+  if (!hasCode) {
+    return { standard: 'unknown', hasCode: false };
+  }
+
+  const [is721, is1155] = await Promise.all([
+    supports(client, address, INTERFACE_ID_ERC721),
+    supports(client, address, INTERFACE_ID_ERC1155),
+  ]);
+
+  let standard: TokenStandard = is721 ? 'erc721' : is1155 ? 'erc1155' : 'unknown';
+
+  if (standard === 'unknown') {
+    const balance = await tryRead(() =>
+      client.readContract({
+        address,
+        abi: METADATA_ABI,
+        functionName: 'balanceOf',
+        args: ['0x000000000000000000000000000000000000dEaD'],
+      }),
+    );
+    // `balanceOf(address)` with a single arg is the ERC-721 shape; ERC-1155
+    // requires a token id, so a bare call would revert there.
+    if (balance !== undefined) standard = 'erc721';
+  }
+
+  const [name, symbol, totalSupply] = await Promise.all([
+    tryRead(() => client.readContract({ address, abi: METADATA_ABI, functionName: 'name' })),
+    tryRead(() => client.readContract({ address, abi: METADATA_ABI, functionName: 'symbol' })),
+    tryRead(() => client.readContract({ address, abi: METADATA_ABI, functionName: 'totalSupply' })),
+  ]);
+
+  return { standard, name, symbol, totalSupply, hasCode: true };
+}
diff --git a/src/screening/mintPlan.ts b/src/screening/mintPlan.ts
new file mode 100644
index 0000000..b6bdfbd
--- /dev/null
+++ b/src/screening/mintPlan.ts
@@ -0,0 +1,233 @@
+import {
+  encodeFunctionData,
+  parseAbiItem,
+  zeroAddress,
+  type Abi,
+  type AbiFunction,
+  type PublicClient,
+} from 'viem';
+import { shortError } from '../logger';
+import type { Address, Hex, MintPlan, TokenStandard } from '../types';
+import { buildSeadropCall, isDropLive, readPublicDrop } from './seadrop';
+
+/** thirdweb's sentinel for "pay in the chain's native token". */
+const NATIVE_TOKEN: Address = '0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE';
+
+interface RouteTemplate {
+  signature: string;
+  /** Only offered for matching standards. */
+  standards: TokenStandard[];
+  args: (params: { minter: Address; quantity: number }) => readonly unknown[];
+}
+
+/**
+ * Ordered most- to least-likely. Every entry is called with `value: 0`, which
+ * is what makes this a *free*-mint bot rather than a buy bot: any route that
+ * actually charges for the mint reverts during simulation and is discarded.
+ */
+const ROUTES: RouteTemplate[] = [
+  {
+    signature: 'function mint(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function publicMint(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function mint(address to, uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ minter, quantity }) => [minter, BigInt(quantity)],
+  },
+  {
+    signature: 'function mintPublic(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function freeMint(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function mintTo(address to, uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ minter, quantity }) => [minter, BigInt(quantity)],
+  },
+  {
+    signature: 'function claim(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function purchase(uint256 quantity)',
+    standards: ['erc721'],
+    args: ({ quantity }) => [BigInt(quantity)],
+  },
+  {
+    signature: 'function safeMint(address to)',
+    standards: ['erc721'],
+    args: ({ minter }) => [minter],
+  },
+  {
+    signature: 'function mint()',
+    standards: ['erc721'],
+    args: () => [],
+  },
+  // thirdweb DropERC721 / DropERC1155 — public phase, empty allowlist proof.
+  {
+    signature:
+      'function claim(address receiver, uint256 quantity, address currency, uint256 pricePerToken, (bytes32[] proof, uint256 quantityLimitPerWallet, uint256 pricePerToken, address currency) allowlistProof, bytes data)',
+    standards: ['erc721', 'erc1155'],
+    args: ({ minter, quantity }) => [
+      minter,
+      BigInt(quantity),
+      NATIVE_TOKEN,
+      0n,
+      { proof: [], quantityLimitPerWallet: 0n, pricePerToken: 0n, currency: zeroAddress },
+      '0x',
+    ],
+  },
+  {
+    signature: 'function mint(uint256 id, uint256 quantity)',
+    standards: ['erc1155'],
+    args: ({ quantity }) => [0n, BigInt(quantity)],
+  },
+  {
+    signature: 'function mint(address to, uint256 id, uint256 quantity, bytes data)',
+    standards: ['erc1155'],
+    args: ({ minter, quantity }) => [minter, 0n, BigInt(quantity), '0x'],
+  },
+  {
+    signature: 'function publicMint(uint256 id, uint256 quantity)',
+    standards: ['erc1155'],
+    args: ({ quantity }) => [1n, BigInt(quantity)],
+  },
+  {
+    signature: 'function mint(uint256 id, uint256 quantity)',
+    standards: ['erc1155'],
+    args: ({ quantity }) => [1n, BigInt(quantity)],
+  },
+];
+
+export interface CandidateCall {
+  label: string;
+  to: Address;
+  data: Hex;
+}
+
+function encodeRoute(
+  template: RouteTemplate,
+  nft: Address,
+  params: { minter: Address; quantity: number },
+): CandidateCall | undefined {
+  try {
+    const item = parseAbiItem(template.signature) as AbiFunction;
+    const data = encodeFunctionData({
+      abi: [item] as Abi,
+      functionName: item.name,
+      args: template.args(params),
+    });
+    // Disambiguate the two `mint(uint256,uint256)` variants by their token id.
+    const suffix = template.signature.includes('uint256 id')
+      ? ` id=${String(template.args(params)[0])}`
+      : '';
+    return { label: `${template.signature.replace(/^function /, '')}${suffix}`, to: nft, data };
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Every call we are willing to try, in priority order. SeaDrop goes first when
+ * the collection has a live zero-price public drop, because that is a positive
+ * signal rather than a guess.
+ */
+export async function buildCandidateCalls(
+  client: PublicClient,
+  nft: Address,
+  minter: Address,
+  quantity: number,
+  standard: TokenStandard,
+): Promise<CandidateCall[]> {
+  const calls: CandidateCall[] = [];
+
+  const drop = await readPublicDrop(client, nft);
+  if (drop && drop.mintPrice === 0n && isDropLive(drop)) {
+    const seadrop = await buildSeadropCall(client, nft, minter, quantity);
+    calls.push({ label: 'SeaDrop.mintPublic', ...seadrop });
+  }
+
+  for (const template of ROUTES) {
+    if (!template.standards.includes(standard)) continue;
+    const call = encodeRoute(template, nft, { minter, quantity });
+    if (call) calls.push(call);
+  }
+
+  return calls;
+}
+
+export interface ProbeResult {
+  plan?: MintPlan;
+  /** Every route we tried and why it was discarded, for diagnostics. */
+  tried: Array<{ label: string; reason: string }>;
+}
+
+/**
+ * Finds the first route that a node will accept with `value: 0`.
+ *
+ * `estimateGas` executes the call against current state, so a route that
+ * survives it is one that would really mint: not sold out, not paused, not
+ * allowlist-gated against us, and not charging a fee.
+ */
+export async function findMintPlan(params: {
+  client: PublicClient;
+  nft: Address;
+  minter: Address;
+  quantity: number;
+  standard: TokenStandard;
+  maxGasUnits: number;
+}): Promise<ProbeResult> {
+  const { client, nft, minter, quantity, standard, maxGasUnits } = params;
+  const calls = await buildCandidateCalls(client, nft, minter, quantity, standard);
+  const tried: ProbeResult['tried'] = [];
+
+  for (const call of calls) {
+    let gasEstimate: bigint;
+    try {
+      gasEstimate = await client.estimateGas({
+        account: minter,
+        to: call.to,
+        data: call.data,
+        value: 0n,
+      });
+    } catch (err) {
+      tried.push({ label: call.label, reason: shortError(err) });
+      continue;
+    }
+
+    if (gasEstimate > BigInt(maxGasUnits)) {
+      tried.push({
+        label: call.label,
+        reason: `gas estimate ${gasEstimate} exceeds maxGasUnits ${maxGasUnits}`,
+      });
+      continue;
+    }
+
+    return {
+      plan: {
+        label: call.label,
+        to: call.to,
+        data: call.data,
+        value: 0n,
+        quantity,
+        gasEstimate,
+      },
+      tried,
+    };
+  }
+
+  return { tried };
+}
