@@ -0,0 +1,42 @@
+import { existsSync } from 'node:fs';
+import { resolve } from 'node:path';
+import type { ChainConfig } from './config';
+import type { Store } from './state/store';
+
+export interface BudgetVerdict {
+  allowed: boolean;
+  reason?: string;
+}
+
+/**
+ * Two independent ceilings: one per mint, one per UTC day per chain. Both are
+ * denominated in wei of gas cost, since a free mint's only cost is gas.
+ */
+export function checkGasBudget(
+  store: Store,
+  cfg: ChainConfig,
+  gasCostWei: bigint,
+  now = new Date(),
+): BudgetVerdict {
+  if (gasCostWei > cfg.maxGasCostWei) {
+    return {
+      allowed: false,
+      reason: `gas cost ${gasCostWei} wei exceeds per-mint cap ${cfg.maxGasCostWei} wei`,
+    };
+  }
+
+  const spent = store.spentToday(cfg.id, now);
+  if (spent + gasCostWei > cfg.dailyGasBudgetWei) {
+    return {
+      allowed: false,
+      reason: `daily gas budget exhausted on ${cfg.name}: spent ${spent} + ${gasCostWei} > ${cfg.dailyGasBudgetWei} wei`,
+    };
+  }
+
+  return { allowed: true };
+}
+
+/** A file on disk that halts minting without needing to kill the process. */
+export function killSwitchEngaged(path: string, cwd = process.cwd()): boolean {
+  return existsSync(resolve(cwd, path));
+}
diff --git a/src/chains.ts b/src/chains.ts
new file mode 100644
index 0000000..47095cf
--- /dev/null
+++ b/src/chains.ts
@@ -0,0 +1,68 @@
+import {
+  createPublicClient,
+  createWalletClient,
+  defineChain,
+  http,
+  type Chain,
+  type PublicClient,
+  type WalletClient,
+} from 'viem';
+import { privateKeyToAccount } from 'viem/accounts';
+import type { ChainConfig, Secrets } from './config';
+import type { Address } from './types';
+
+/**
+ * Built from config rather than viem/chains so that adding a chain is a config
+ * edit, not a code change.
+ */
+export function toViemChain(cfg: ChainConfig): Chain {
+  return defineChain({
+    id: cfg.id,
+    name: cfg.name,
+    nativeCurrency: cfg.nativeCurrency,
+    rpcUrls: { default: { http: [cfg.rpcUrl] } },
+  });
+}
+
+export interface ChainContext {
+  cfg: ChainConfig;
+  chain: Chain;
+  public: PublicClient;
+  wallet?: WalletClient;
+  /** Address transactions are sent from, or the simulation stand-in. */
+  account: Address;
+  /** True when we hold the key and can actually broadcast. */
+  canSend: boolean;
+}
+
+/**
+ * Simulating needs a non-zero `from`. When no key is configured we borrow a
+ * well-known address so `eth_estimateGas` behaves like a real caller.
+ */
+const SIMULATION_FALLBACK: Address = '0x000000000000000000000000000000000000dEaD';
+
+export function makeChainContext(cfg: ChainConfig, secrets: Secrets): ChainContext {
+  const chain = toViemChain(cfg);
+  const transport = http(cfg.rpcUrl, { batch: true, retryCount: 2 });
+  const publicClient = createPublicClient({ chain, transport });
+
+  if (secrets.privateKey) {
+    const account = privateKeyToAccount(secrets.privateKey);
+    return {
+      cfg,
+      chain,
+      public: publicClient,
+      wallet: createWalletClient({ account, chain, transport }),
+      account: account.address,
+      canSend: true,
+    };
+  }
+
+  return {
+    cfg,
+    chain,
+    public: publicClient,
+    account: secrets.simulationAddress ?? SIMULATION_FALLBACK,
+    canSend: false,
+  };
+}
diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..261281b
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,147 @@
+#!/usr/bin/env -S npx tsx
+import { formatEther, getAddress, isAddress } from 'viem';
+import { makeChainContext } from './chains';
+import { enabledChains, loadConfig } from './config';
+import { log, shortError } from './logger';
+import { createRunner } from './run';
+import { screenOne } from './screening/index';
+import { Store } from './state/store';
+import type { Candidate } from './types';
+
+const USAGE = `automint — mints free public NFT drops from a burner wallet
+
+Usage:
+  automint run                       watch continuously
+  automint once                      run a single discovery pass and exit
+  automint check <chainId> <address> screen one contract and print the mint plan
+  automint wallet                    show the configured wallet and balances
+  automint state                     summarise what has been attempted so far
+
+Config lives in automint.config.json; secrets in .env (see .env.example).
+`;
+
+async function main(argv: string[]): Promise<number> {
+  const command = argv[0] ?? 'run';
+
+  if (command === '--help' || command === '-h' || command === 'help') {
+    process.stdout.write(USAGE);
+    return 0;
+  }
+
+  const loaded = loadConfig();
+
+  switch (command) {
+    case 'run': {
+      const runner = createRunner(loaded);
+      const shutdown = () => {
+        log.info('shutdown requested');
+        runner.stop();
+      };
+      process.on('SIGINT', shutdown);
+      process.on('SIGTERM', shutdown);
+      await runner.runForever();
+      return 0;
+    }
+
+    case 'once': {
+      const runner = createRunner(loaded);
+      const summary = await runner.runOnce();
+      log.info('pass complete', { ...summary });
+      return 0;
+    }
+
+    case 'check': {
+      const chainIdRaw = argv[1];
+      const addressRaw = argv[2];
+      if (!chainIdRaw || !addressRaw) {
+        process.stderr.write('usage: automint check <chainId> <address>\n');
+        return 2;
+      }
+      if (!isAddress(addressRaw)) {
+        process.stderr.write(`not an address: ${addressRaw}\n`);
+        return 2;
+      }
+      const chainId = Number(chainIdRaw);
+      const cfg = loaded.config.chains.find((c) => c.id === chainId);
+      if (!cfg) {
+        process.stderr.write(`chain ${chainId} is not in automint.config.json\n`);
+        return 2;
+      }
+
+      const ctx = makeChainContext(cfg, loaded.secrets);
+      const store = Store.open(loaded.config.statePath);
+      const candidate: Candidate = {
+        chainId,
+        contract: getAddress(addressRaw),
+        source: 'manual',
+        discoveredAt: Date.now(),
+        liveAt: Date.now(),
+      };
+
+      const result = await screenOne(candidate, ctx, loaded.config, store);
+      process.stdout.write(
+        `${JSON.stringify(
+          {
+            contract: candidate.contract,
+            chain: cfg.name,
+            minterUsed: ctx.account,
+            standard: result.info.standard,
+            name: result.info.name,
+            symbol: result.info.symbol,
+            totalSupply: result.info.totalSupply,
+            mintable: !!result.plan && result.rejections.length === 0,
+            route: result.plan?.label,
+            gasEstimate: result.plan?.gasEstimate,
+            rejections: result.rejections,
+          },
+          (_k, v) => (typeof v === 'bigint' ? v.toString() : v),
+          2,
+        )}\n`,
+      );
+      return result.plan && result.rejections.length === 0 ? 0 : 1;
+    }
+
+    case 'wallet': {
+      const chains = enabledChains(loaded.config);
+      const contexts = chains.map((cfg) => makeChainContext(cfg, loaded.secrets));
+      const first = contexts[0];
+      if (!first) {
+        process.stderr.write('no enabled chains in automint.config.json\n');
+        return 2;
+      }
+
+      process.stdout.write(`address:  ${first.account}\n`);
+      process.stdout.write(`can send: ${first.canSend}\n`);
+      process.stdout.write(`dry run:  ${loaded.config.dryRun}\n\n`);
+
+      for (const ctx of contexts) {
+        try {
+          const balance = await ctx.public.getBalance({ address: ctx.account });
+          process.stdout.write(
+            `${ctx.cfg.name.padEnd(12)} ${formatEther(balance)} ${ctx.cfg.nativeCurrency.symbol}\n`,
+          );
+        } catch (err) {
+          process.stdout.write(`${ctx.cfg.name.padEnd(12)} error: ${shortError(err)}\n`);
+        }
+      }
+      return 0;
+    }
+
+    case 'state': {
+      const store = Store.open(loaded.config.statePath);
+      process.stdout.write(`${JSON.stringify(store.summary(), null, 2)}\n`);
+      return 0;
+    }
+
+    default:
+      process.stderr.write(`unknown command: ${command}\n\n${USAGE}`);
+      return 2;
+  }
+}
+
+main(process.argv.slice(2))
+  .then((code) => process.exit(code))
+  .catch((err) => {
+    log.error('fatal', { err: shortError(err) });
+    process.exit(1);
+  });
diff --git a/src/config.ts b/src/config.ts
new file mode 100644
index 0000000..f01ea6b
--- /dev/null
+++ b/src/config.ts
@@ -0,0 +1,164 @@
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { getAddress, isAddress } from 'viem';
+import { z } from 'zod';
+import type { Address } from './types';
+
+/** Wei amounts live in JSON as decimal strings so they survive the round trip. */
+const weiString = z
+  .string()
+  .regex(/^\d+$/, 'must be a decimal wei string')
+  .transform((s) => BigInt(s));
+
+const addressSchema = z
+  .string()
+  .refine((s) => isAddress(s), 'must be a 0x address')
+  .transform((s) => getAddress(s));
+
+const chainSchema = z.object({
+  id: z.number().int().positive(),
+  name: z.string().min(1),
+  rpcUrl: z.string().url(),
+  enabled: z.boolean().default(true),
+  /** Chain slug used by the OpenSea API, e.g. "base". Omit to skip that adapter. */
+  openseaChain: z.string().optional(),
+  nativeCurrency: z
+    .object({
+      name: z.string().default('Ether'),
+      symbol: z.string().default('ETH'),
+      decimals: z.number().int().default(18),
+    })
+    .default({ name: 'Ether', symbol: 'ETH', decimals: 18 }),
+  /** Hard ceiling on gas cost for a single mint. */
+  maxGasCostWei: weiString,
+  /** Rolling per-UTC-day ceiling on total gas spend for this chain. */
+  dailyGasBudgetWei: weiString,
+});
+
+const configSchema = z.object({
+  dryRun: z.boolean().default(true),
+  pollIntervalMs: z.number().int().min(1000).default(15_000),
+  statePath: z.string().default('.automint/state.json'),
+  killSwitchPath: z.string().default('.automint/STOP'),
+  chains: z.array(chainSchema).min(1),
+  mint: z
+    .object({
+      quantity: z.number().int().min(1).max(20).default(1),
+      /** Ignore collections that went live longer ago than this. */
+      maxAgeSeconds: z.number().int().min(60).default(3600),
+      confirmations: z.number().int().min(0).max(12).default(1),
+      maxGasUnits: z.number().int().min(21_000).default(500_000),
+      maxPriorityFeeGwei: z.number().positive().default(1.5),
+      /** Require a simulated Transfer to our own address before sending. */
+      requireTransferToSelf: z.boolean().default(true),
+    })
+    .default({}),
+  discovery: z
+    .object({
+      opensea: z
+        .object({
+          enabled: z.boolean().default(false),
+          limit: z.number().int().min(1).max(100).default(50),
+        })
+        .default({}),
+      onchain: z
+        .object({
+          enabled: z.boolean().default(true),
+          blockLookback: z.number().int().min(1).max(2000).default(60),
+          maxCandidatesPerScan: z.number().int().min(1).default(40),
+        })
+        .default({}),
+    })
+    .default({}),
+  denylist: z.array(addressSchema).default([]),
+  allowlist: z.array(addressSchema).default([]),
+  allowlistOnly: z.boolean().default(false),
+});
+
+export type ChainConfig = z.infer<typeof chainSchema>;
+export type Config = z.infer<typeof configSchema>;
+
+export interface Secrets {
+  privateKey?: `0x${string}`;
+  openseaApiKey?: string;
+  /** "from" address for simulations when there is no private key. */
+  simulationAddress?: Address;
+}
+
+export interface LoadedConfig {
+  config: Config;
+  secrets: Secrets;
+  /** Absolute path the config was read from. */
+  path: string;
+}
+
+function loadEnvFile(cwd: string) {
+  const envPath = resolve(cwd, '.env');
+  if (!existsSync(envPath)) return;
+  // Node >= 20.12. Falls back to a no-op on older runtimes.
+  const loader = (process as unknown as { loadEnvFile?: (p: string) => void }).loadEnvFile;
+  if (typeof loader === 'function') loader.call(process, envPath);
+}
+
+function parseBool(raw: string | undefined): boolean | undefined {
+  if (raw === undefined || raw === '') return undefined;
+  if (['1', 'true', 'yes', 'on'].includes(raw.toLowerCase())) return true;
+  if (['0', 'false', 'no', 'off'].includes(raw.toLowerCase())) return false;
+  throw new Error(`cannot parse "${raw}" as a boolean`);
+}
+
+export function loadConfig(opts: { cwd?: string; configPath?: string } = {}): LoadedConfig {
+  const cwd = opts.cwd ?? process.cwd();
+  loadEnvFile(cwd);
+
+  const path = resolve(cwd, opts.configPath ?? 'automint.config.json');
+  if (!existsSync(path)) {
+    throw new Error(`config not found at ${path} (copy automint.config.json from the repo root)`);
+  }
+
+  let raw: unknown;
+  try {
+    raw = JSON.parse(readFileSync(path, 'utf8'));
+  } catch (err) {
+    throw new Error(`${path} is not valid JSON: ${(err as Error).message}`);
+  }
+
+  const parsed = configSchema.safeParse(raw);
+  if (!parsed.success) {
+    const issues = parsed.error.issues
+      .map((i) => `  - ${i.path.join('.') || '(root)'}: ${i.message}`)
+      .join('\n');
+    throw new Error(`invalid ${path}:\n${issues}`);
+  }
+  const config = parsed.data;
+
+  // Env wins over the file so you can flip to live without editing config.
+  const dryRunOverride = parseBool(process.env.AUTOMINT_DRY_RUN);
+  if (dryRunOverride !== undefined) config.dryRun = dryRunOverride;
+
+  const pk = process.env.AUTOMINT_PRIVATE_KEY?.trim();
+  if (pk && !/^0x[0-9a-fA-F]{64}$/.test(pk)) {
+    throw new Error('AUTOMINT_PRIVATE_KEY must be 0x followed by 64 hex characters');
+  }
+  const simAddrRaw = process.env.AUTOMINT_SIMULATION_ADDRESS?.trim();
+  if (simAddrRaw && !isAddress(simAddrRaw)) {
+    throw new Error('AUTOMINT_SIMULATION_ADDRESS must be a 0x address');
+  }
+
+  const zeroKey = '0x' + '0'.repeat(64);
+  const secrets: Secrets = {
+    privateKey: pk && pk !== zeroKey ? (pk as `0x${string}`) : undefined,
+    openseaApiKey: process.env.OPENSEA_API_KEY?.trim() || undefined,
+    simulationAddress: simAddrRaw ? getAddress(simAddrRaw) : undefined,
+  };
+
+  if (!config.dryRun && !secrets.privateKey) {
+    throw new Error('dryRun is false but AUTOMINT_PRIVATE_KEY is not set — refusing to start');
+  }
+
+  return { config, secrets, path };
+}
+
+export function enabledChains(config: Config): ChainConfig[] {
+  return config.chains.filter((c) => c.enabled);
+}
diff --git a/src/discovery/index.ts b/src/discovery/index.ts
new file mode 100644
index 0000000..f2fd21c
--- /dev/null
+++ b/src/discovery/index.ts
@@ -0,0 +1,95 @@
+import type { ChainContext } from '../chains';
+import type { Config } from '../config';
+import { log, shortError } from '../logger';
+import type { Store } from '../state/store';
+import type { Candidate } from '../types';
+import { discoverOnchain } from './onchain';
+import { discoverOpensea } from './opensea';
+
+export interface DiscoveryDeps {
+  ctx: ChainContext;
+  config: Config;
+  store: Store;
+  openseaApiKey?: string;
+}
+
+/**
+ * Runs every enabled adapter and merges the results. Adapters are independent:
+ * one failing (rate limit, RPC hiccup) must not starve the others.
+ */
+export async function discover(deps: DiscoveryDeps): Promise<Candidate[]> {
+  const { ctx, config } = deps;
+  const tasks: Array<Promise<Candidate[]>> = [];
+
+  if (config.discovery.onchain.enabled) {
+    tasks.push(discoverOnchain(deps));
+  }
+  if (config.discovery.opensea.enabled && ctx.cfg.openseaChain) {
+    tasks.push(discoverOpensea(deps));
+  }
+
+  const settled = await Promise.allSettled(tasks);
+  const merged = new Map<string, Candidate>();
+
+  for (const result of settled) {
+    if (result.status === 'rejected') {
+      log.warn('discovery adapter failed', {
+        chain: ctx.cfg.name,
+        err: shortError(result.reason),
+      });
+      continue;
+    }
+    for (const candidate of result.value) {
+      const key = candidate.contract.toLowerCase();
+      // First adapter to report a contract wins; on-chain runs first and
+      // carries the more reliable "just went live" signal.
+      if (!merged.has(key)) merged.set(key, candidate);
+    }
+  }
+
+  return [...merged.values()];
+}
+
+/**
+ * Applies allow/deny lists, the freshness window, and the "already handled"
+ * check. Kept separate from the adapters so it is easy to unit test.
+ */
+export function filterCandidates(
+  candidates: Candidate[],
+  config: Config,
+  store: Store,
+  now = Date.now(),
+): { keep: Candidate[]; dropped: Array<{ candidate: Candidate; reason: string }> } {
+  const deny = new Set(config.denylist.map((a) => a.toLowerCase()));
+  const allow = new Set(config.allowlist.map((a) => a.toLowerCase()));
+  const maxAgeMs = config.mint.maxAgeSeconds * 1000;
+
+  const keep: Candidate[] = [];
+  const dropped: Array<{ candidate: Candidate; reason: string }> = [];
+
+  for (const c of candidates) {
+    const addr = c.contract.toLowerCase();
+
+    if (deny.has(addr)) {
+      dropped.push({ candidate: c, reason: 'on denylist' });
+      continue;
+    }
+    if (config.allowlistOnly && !allow.has(addr)) {
+      dropped.push({ candidate: c, reason: 'allowlistOnly is set and contract is not allowlisted' });
+      continue;
+    }
+    if (store.isSettled(c.chainId, c.contract)) {
+      dropped.push({ candidate: c, reason: 'already handled' });
+      continue;
+    }
+    const liveAt = c.liveAt ?? c.discoveredAt;
+    if (now - liveAt > maxAgeMs) {
+      dropped.push({ candidate: c, reason: `older than maxAgeSeconds (${config.mint.maxAgeSeconds}s)` });
+      continue;
+    }
+
+    keep.push(c);
+  }
+
+  return { keep, dropped };
+}
diff --git a/src/discovery/onchain.ts b/src/discovery/onchain.ts
new file mode 100644
index 0000000..4d551d5
--- /dev/null
+++ b/src/discovery/onchain.ts
@@ -0,0 +1,100 @@
+import { getAddress, parseAbiItem, zeroAddress } from 'viem';
+import { log } from '../logger';
+import type { Address, Candidate } from '../types';
+import type { DiscoveryDeps } from './index';
+
+const TRANSFER_721 = parseAbiItem(
+  'event Transfer(address indexed from, address indexed to, uint256 indexed tokenId)',
+);
+const TRANSFER_SINGLE_1155 = parseAbiItem(
+  'event TransferSingle(address indexed operator, address indexed from, address indexed to, uint256 id, uint256 value)',
+);
+
+/**
+ * The most reliable "a mint just went live" signal is a mint event itself:
+ * ERC-721 `Transfer` / ERC-1155 `TransferSingle` with `from == address(0)`.
+ * We sweep recent blocks for those and treat each distinct emitting contract as
+ * a candidate.
+ *
+ * This finds collections regardless of whether any marketplace has indexed them
+ * yet, which is the whole point — by the time OpenSea lists a free mint, the
+ * supply is often gone.
+ */
+export async function discoverOnchain(deps: DiscoveryDeps): Promise<Candidate[]> {
+  const { ctx, config, store } = deps;
+  const { blockLookback, maxCandidatesPerScan } = config.discovery.onchain;
+
+  const head = await ctx.public.getBlockNumber();
+  const cursor = store.getCursor(ctx.cfg.id);
+
+  // Start `blockLookback` behind the head on a cold start; afterwards resume
+  // from the cursor, but never sweep a window wider than the lookback.
+  const lookback = BigInt(blockLookback);
+  const floor = head > lookback ? head - lookback : 0n;
+  const fromBlock = cursor === undefined ? floor : cursor + 1n > floor ? cursor + 1n : floor;
+
+  if (fromBlock > head) {
+    log.debug('no new blocks', { chain: ctx.cfg.name, head });
+    return [];
+  }
+
+  const [logs721, logs1155] = await Promise.all([
+    ctx.public.getLogs({
+      event: TRANSFER_721,
+      args: { from: zeroAddress },
+      fromBlock,
+      toBlock: head,
+    }),
+    ctx.public.getLogs({
+      event: TRANSFER_SINGLE_1155,
+      args: { from: zeroAddress },
+      fromBlock,
+      toBlock: head,
+    }),
+  ]);
+
+  // Count mints per contract so we can prefer the ones actually seeing action.
+  const hits = new Map<string, { address: Address; mints: number; firstBlock: bigint }>();
+  for (const entry of [...logs721, ...logs1155]) {
+    const key = entry.address.toLowerCase();
+    const existing = hits.get(key);
+    if (existing) {
+      existing.mints += 1;
+      if (entry.blockNumber !== null && entry.blockNumber < existing.firstBlock) {
+        existing.firstBlock = entry.blockNumber;
+      }
+    } else {
+      hits.set(key, {
+        address: getAddress(entry.address),
+        mints: 1,
+        firstBlock: entry.blockNumber ?? head,
+      });
+    }
+  }
+
+  store.setCursor(ctx.cfg.id, head);
+
+  const now = Date.now();
+  const candidates = [...hits.values()]
+    .sort((a, b) => b.mints - a.mints)
+    .slice(0, maxCandidatesPerScan)
+    .map<Candidate>((hit) => ({
+      chainId: ctx.cfg.id,
+      contract: hit.address,
+      source: 'onchain',
+      discoveredAt: now,
+      // We only know it was minting inside this window, so treat "live" as now.
+      // The freshness filter is really doing "is it minting right now".
+      liveAt: now,
+    }));
+
+  log.debug('onchain scan complete', {
+    chain: ctx.cfg.name,
+    fromBlock,
+    toBlock: head,
+    contracts: hits.size,
+    candidates: candidates.length,
+  });
+
+  return candidates;
+}
diff --git a/src/discovery/opensea.ts b/src/discovery/opensea.ts
new file mode 100644
index 0000000..6791628
--- /dev/null
+++ b/src/discovery/opensea.ts
@@ -0,0 +1,83 @@
+import { getAddress, isAddress } from 'viem';
+import { log } from '../logger';
+import type { Candidate } from '../types';
+import type { DiscoveryDeps } from './index';
+
+const OPENSEA_API = 'https://api.opensea.io/api/v2';
+
+interface OpenseaCollection {
+  collection?: string;
+  name?: string;
+  created_date?: string;
+  contracts?: Array<{ address?: string; chain?: string }>;
+}
+
+interface OpenseaCollectionsResponse {
+  collections?: OpenseaCollection[];
+  next?: string;
+}
+
+/**
+ * Newest collections OpenSea knows about, ordered by creation date.
+ *
+ * Note this adapter does not decide whether a mint is free — OpenSea's public
+ * API does not expose mint stages for arbitrary contracts. Free-ness is
+ * established on-chain during screening, by simulating a zero-value mint.
+ */
+export async function discoverOpensea(deps: DiscoveryDeps): Promise<Candidate[]> {
+  const { ctx, config, openseaApiKey } = deps;
+  const chainSlug = ctx.cfg.openseaChain;
+  if (!chainSlug) return [];
+  if (!openseaApiKey) {
+    log.warn('opensea discovery enabled but OPENSEA_API_KEY is unset — skipping');
+    return [];
+  }
+
+  const url = new URL(`${OPENSEA_API}/collections`);
+  url.searchParams.set('chain', chainSlug);
+  url.searchParams.set('order_by', 'created_date');
+  url.searchParams.set('limit', String(config.discovery.opensea.limit));
+
+  const res = await fetch(url, {
+    headers: { accept: 'application/json', 'x-api-key': openseaApiKey },
+    signal: AbortSignal.timeout(15_000),
+  });
+
+  if (res.status === 429) {
+    throw new Error('opensea rate limited (429)');
+  }
+  if (!res.ok) {
+    throw new Error(`opensea returned ${res.status} ${res.statusText}`);
+  }
+
+  const body = (await res.json()) as OpenseaCollectionsResponse;
+  const now = Date.now();
+  const candidates: Candidate[] = [];
+
+  for (const collection of body.collections ?? []) {
+    const match = (collection.contracts ?? []).find(
+      (c) => c.chain === chainSlug && c.address && isAddress(c.address),
+    );
+    if (!match?.address) continue;
+
+    const created = collection.created_date ? Date.parse(collection.created_date) : Number.NaN;
+
+    candidates.push({
+      chainId: ctx.cfg.id,
+      contract: getAddress(match.address),
+      source: 'opensea',
+      discoveredAt: now,
+      liveAt: Number.isNaN(created) ? undefined : created,
+      name: collection.name,
+      openseaSlug: collection.collection,
+    });
+  }
+
+  log.debug('opensea scan complete', {
+    chain: ctx.cfg.name,
+    returned: body.collections?.length ?? 0,
+    candidates: candidates.length,
+  });
+
+  return candidates;
+}
diff --git a/src/execute/fees.ts b/src/execute/fees.ts
new file mode 100644
index 0000000..6ba248a
--- /dev/null
+++ b/src/execute/fees.ts
@@ -0,0 +1,34 @@
+import { parseGwei, type PublicClient } from 'viem';
+
+export interface Fees {
+  maxFeePerGas: bigint;
+  maxPriorityFeePerGas: bigint;
+}
+
+/**
+ * EIP-1559 fees with our own priority-fee ceiling applied. We deliberately do
+ * not bid aggressively: losing a free mint costs nothing, overpaying does.
+ */
+export async function resolveFees(
+  client: PublicClient,
+  maxPriorityFeeGwei: number,
+): Promise<Fees> {
+  const cap = parseGwei(String(maxPriorityFeeGwei));
+  const estimated = await client.estimateFeesPerGas();
+
+  const maxPriorityFeePerGas =
+    estimated.maxPriorityFeePerGas !== undefined && estimated.maxPriorityFeePerGas < cap
+      ? estimated.maxPriorityFeePerGas
+      : cap;
+
+  // Keep the base-fee headroom the node suggested, but never below our tip.
+  const suggested = estimated.maxFeePerGas ?? maxPriorityFeePerGas;
+  const maxFeePerGas = suggested > maxPriorityFeePerGas ? suggested : maxPriorityFeePerGas;
+
+  return { maxFeePerGas, maxPriorityFeePerGas };
+}
+
+/** Worst-case cost of a transaction, which is what budgets should be checked against. */
+export function worstCaseGasCost(gasUnits: bigint, fees: Fees): bigint {
+  return gasUnits * fees.maxFeePerGas;
+}
diff --git a/src/execute/mint.ts b/src/execute/mint.ts
new file mode 100644
index 0000000..a451351
--- /dev/null
+++ b/src/execute/mint.ts
@@ -0,0 +1,131 @@
+import type { ChainContext } from '../chains';
+import type { Config } from '../config';
+import { log, shortError } from '../logger';
+import type { Store } from '../state/store';
+import type { AttemptRecord, Candidate, MintPlan } from '../types';
+import type { Fees } from './fees';
+
+export interface MintDeps {
+  ctx: ChainContext;
+  config: Config;
+  store: Store;
+  fees: Fees;
+}
+
+/** Small headroom over the estimate so a block-boundary state change won't OOG. */
+function gasLimitFor(estimate: bigint, maxGasUnits: number): bigint {
+  const padded = (estimate * 125n) / 100n;
+  const cap = BigInt(maxGasUnits);
+  return padded > cap ? cap : padded;
+}
+
+/**
+ * Sends the mint and waits for it to land. Returns the record to persist,
+ * whatever the outcome — a failed mint we know about is worth remembering.
+ */
+export async function executeMint(
+  candidate: Candidate,
+  plan: MintPlan,
+  deps: MintDeps,
+): Promise<AttemptRecord> {
+  const { ctx, config, store, fees } = deps;
+  const now = Date.now();
+
+  if (config.dryRun || !ctx.wallet || !ctx.canSend) {
+    log.info('DRY RUN — would mint', {
+      chain: ctx.cfg.name,
+      contract: candidate.contract,
+      name: candidate.name,
+      route: plan.label,
+      to: plan.to,
+      gasEstimate: plan.gasEstimate,
+      maxFeePerGas: fees.maxFeePerGas,
+    });
+    return { status: 'dry-run', at: now, label: plan.label };
+  }
+
+  const account = ctx.wallet.account;
+  if (!account) {
+    return { status: 'failed', at: now, label: plan.label, reason: 'wallet has no account' };
+  }
+
+  let hash: `0x${string}`;
+  try {
+    hash = await ctx.wallet.sendTransaction({
+      account,
+      chain: ctx.chain,
+      to: plan.to,
+      data: plan.data,
+      // Structurally pinned to 0 — this bot never pays for a mint.
+      value: plan.value,
+      gas: gasLimitFor(plan.gasEstimate, config.mint.maxGasUnits),
+      maxFeePerGas: fees.maxFeePerGas,
+      maxPriorityFeePerGas: fees.maxPriorityFeePerGas,
+    });
+  } catch (err) {
+    log.warn('mint transaction rejected before broadcast', {
+      contract: candidate.contract,
+      err: shortError(err),
+    });
+    return { status: 'failed', at: now, label: plan.label, reason: shortError(err) };
+  }
+
+  log.info('mint submitted', {
+    chain: ctx.cfg.name,
+    contract: candidate.contract,
+    route: plan.label,
+    tx: hash,
+  });
+
+  try {
+    const receipt = await ctx.public.waitForTransactionReceipt({
+      hash,
+      confirmations: config.mint.confirmations,
+      timeout: 180_000,
+    });
+
+    const gasCost = receipt.gasUsed * receipt.effectiveGasPrice;
+    // Charge the budget on any inclusion: reverted transactions still cost gas.
+    store.addSpend(ctx.cfg.id, gasCost);
+
+    if (receipt.status !== 'success') {
+      log.warn('mint reverted on chain', { contract: candidate.contract, tx: hash });
+      return {
+        status: 'failed',
+        at: Date.now(),
+        label: plan.label,
+        txHash: hash,
+        gasCostWei: gasCost.toString(),
+        reason: 'transaction reverted on chain',
+      };
+    }
+
+    log.info('minted', {
+      chain: ctx.cfg.name,
+      contract: candidate.contract,
+      name: candidate.name,
+      tx: hash,
+      gasUsed: receipt.gasUsed,
+      gasCostWei: gasCost,
+    });
+
+    return {
+      status: 'minted',
+      at: Date.now(),
+      label: plan.label,
+      txHash: hash,
+      gasCostWei: gasCost.toString(),
+    };
+  } catch (err) {
+    // Broadcast succeeded but we lost track of it. Don't retry — that risks a
+    // duplicate mint. Record it and move on.
+    log.warn('could not confirm mint', { tx: hash, err: shortError(err) });
+    return {
+      status: 'failed',
+      at: Date.now(),
+      label: plan.label,
+      txHash: hash,
+      reason: `unconfirmed: ${shortError(err)}`,
+    };
+  }
+}
diff --git a/src/execute/simulate.ts b/src/execute/simulate.ts
new file mode 100644
index 0000000..bacdef7
--- /dev/null
+++ b/src/execute/simulate.ts
@@ -0,0 +1,131 @@
+import {
+  encodeEventTopics,
+  numberToHex,
+  pad,
+  parseAbiItem,
+  type Hex,
+  type PublicClient,
+} from 'viem';
+import { shortError } from '../logger';
+import type { Address, MintPlan } from '../types';
+
+const TRANSFER_721 = parseAbiItem(
+  'event Transfer(address indexed from, address indexed to, uint256 indexed tokenId)',
+);
+const TRANSFER_SINGLE_1155 = parseAbiItem(
+  'event TransferSingle(address indexed operator, address indexed from, address indexed to, uint256 id, uint256 value)',
+);
+const TRANSFER_BATCH_1155 = parseAbiItem(
+  'event TransferBatch(address indexed operator, address indexed from, address indexed to, uint256[] ids, uint256[] values)',
+);
+
+const [TOPIC_TRANSFER_721] = encodeEventTopics({ abi: [TRANSFER_721], eventName: 'Transfer' });
+const [TOPIC_TRANSFER_SINGLE] = encodeEventTopics({
+  abi: [TRANSFER_SINGLE_1155],
+  eventName: 'TransferSingle',
+});
+const [TOPIC_TRANSFER_BATCH] = encodeEventTopics({
+  abi: [TRANSFER_BATCH_1155],
+  eventName: 'TransferBatch',
+});
+
+/** Position of the `to` topic within each event shape's topic list. */
+const TO_TOPIC_INDEX = new Map<string, number>([
+  [String(TOPIC_TRANSFER_721).toLowerCase(), 2],
+  [String(TOPIC_TRANSFER_SINGLE).toLowerCase(), 3],
+  [String(TOPIC_TRANSFER_BATCH).toLowerCase(), 3],
+]);
+
+interface SimulatedLog {
+  address?: Hex;
+  topics?: Hex[];
+}
+
+interface SimulatedCall {
+  status?: Hex;
+  gasUsed?: Hex;
+  logs?: SimulatedLog[];
+  error?: { message?: string };
+}
+
+interface SimulatedBlock {
+  calls?: SimulatedCall[];
+}
+
+export type SimulationOutcome =
+  | { kind: 'unsupported' }
+  | { kind: 'reverted'; reason: string }
+  | { kind: 'ok'; receivesToken: boolean; tokensReceived: number };
+
+/**
+ * Uses `eth_simulateV1` to confirm the mint actually lands a token in our
+ * wallet, not just that the call doesn't revert. Some contracts happily accept
+ * a `mint()` that mints to the owner, or to nobody at all.
+ *
+ * Not every RPC implements this method; callers must treat `unsupported` as
+ * "no extra information" rather than as a failure.
+ */
+export async function simulateMint(
+  client: PublicClient,
+  plan: MintPlan,
+  minter: Address,
+): Promise<SimulationOutcome> {
+  let result: SimulatedBlock[];
+  try {
+    result = (await client.request({
+      // Not in viem's typed RPC schema, so this goes through as a raw request.
+      method: 'eth_simulateV1',
+      params: [
+        {
+          blockStateCalls: [
+            {
+              calls: [
+                {
+                  from: minter,
+                  to: plan.to,
+                  data: plan.data,
+                  value: numberToHex(plan.value),
+                },
+              ],
+            },
+          ],
+          validation: false,
+          traceTransfers: false,
+        },
+        'latest',
+      ],
+    } as never)) as SimulatedBlock[];
+  } catch (err) {
+    const msg = shortError(err).toLowerCase();
+    if (
+      msg.includes('method not found') ||
+      msg.includes('not supported') ||
+      msg.includes('unsupported') ||
+      msg.includes('does not exist')
+    ) {
+      return { kind: 'unsupported' };
+    }
+    return { kind: 'reverted', reason: shortError(err) };
+  }
+
+  const call = result[0]?.calls?.[0];
+  if (!call) return { kind: 'unsupported' };
+
+  // eth_simulateV1 reports failure in-band rather than by throwing.
+  if (call.status !== undefined && BigInt(call.status) === 0n) {
+    return { kind: 'reverted', reason: call.error?.message ?? 'call reverted in simulation' };
+  }
+
+  const wanted = pad(minter.toLowerCase() as Hex, { size: 32 }).toLowerCase();
+  let tokensReceived = 0;
+
+  for (const entry of call.logs ?? []) {
+    const topic0 = entry.topics?.[0];
+    if (!topic0) continue;
+    const index = TO_TOPIC_INDEX.get(topic0.toLowerCase());
+    if (index === undefined) continue;
+    if (entry.topics?.[index]?.toLowerCase() === wanted) tokensReceived += 1;
+  }
+
+  return { kind: 'ok', receivesToken: tokensReceived > 0, tokensReceived };
+}
diff --git a/src/logger.ts b/src/logger.ts
new file mode 100644
index 0000000..48e37ff
--- /dev/null
+++ b/src/logger.ts
@@ -0,0 +1,42 @@
+type Level = 'debug' | 'info' | 'warn' | 'error';
+
+const ORDER: Record<Level, number> = { debug: 10, info: 20, warn: 30, error: 40 };
+
+const threshold = ORDER[(process.env.AUTOMINT_LOG_LEVEL as Level) ?? 'info'] ?? ORDER.info;
+
+function emit(level: Level, msg: string, fields?: Record<string, unknown>) {
+  if (ORDER[level] < threshold) return;
+  const time = new Date().toISOString();
+  let line = `${time} ${level.toUpperCase().padEnd(5)} ${msg}`;
+  if (fields && Object.keys(fields).length > 0) {
+    const rendered = Object.entries(fields)
+      .map(([k, v]) => `${k}=${format(v)}`)
+      .join(' ');
+    line += `  ${rendered}`;
+  }
+  const sink = level === 'error' || level === 'warn' ? console.error : console.log;
+  sink(line);
+}
+
+function format(v: unknown): string {
+  if (typeof v === 'bigint') return v.toString();
+  if (v instanceof Error) return v.message;
+  if (typeof v === 'object' && v !== null) {
+    return JSON.stringify(v, (_k, val) => (typeof val === 'bigint' ? val.toString() : val));
+  }
+  return String(v);
+}
+
+export const log = {
+  debug: (msg: string, fields?: Record<string, unknown>) => emit('debug', msg, fields),
+  info: (msg: string, fields?: Record<string, unknown>) => emit('info', msg, fields),
+  warn: (msg: string, fields?: Record<string, unknown>) => emit('warn', msg, fields),
+  error: (msg: string, fields?: Record<string, unknown>) => emit('error', msg, fields),
+};
+
+/** viem errors are enormous; keep the first meaningful line. */
+export function shortError(err: unknown): string {
+  const raw = err instanceof Error ? (err.message ?? '') : String(err);
+  const first = raw.split('\n').find((l) => l.trim().length > 0) ?? 'unknown error';
+  return first.trim().slice(0, 200);
+}
diff --git a/src/run.ts b/src/run.ts
new file mode 100644
index 0000000..2b741c4
--- /dev/null
+++ b/src/run.ts
@@ -0,0 +1,186 @@
+import { killSwitchEngaged } from './budget';
+import { makeChainContext, type ChainContext } from './chains';
+import { enabledChains, type LoadedConfig } from './config';
+import { resolveFees } from './execute/fees';
+import { executeMint } from './execute/mint';
+import { discover, filterCandidates } from './discovery/index';
+import { log, shortError } from './logger';
+import { screen } from './screening/index';
+import { Store } from './state/store';
+
+export interface Runner {
+  runOnce(): Promise<PassSummary>;
+  runForever(): Promise<void>;
+  stop(): void;
+  contexts: ChainContext[];
+  store: Store;
+}
+
+export interface PassSummary {
+  discovered: number;
+  screened: number;
+  minted: number;
+  dryRun: number;
+  rejected: number;
+  failed: number;
+}
+
+const EMPTY_SUMMARY: PassSummary = {
+  discovered: 0,
+  screened: 0,
+  minted: 0,
+  dryRun: 0,
+  rejected: 0,
+  failed: 0,
+};
+
+export function createRunner(loaded: LoadedConfig): Runner {
+  const { config, secrets } = loaded;
+  const store = Store.open(config.statePath);
+  const chains = enabledChains(config);
+  const contexts = chains.map((cfg) => makeChainContext(cfg, secrets));
+
+  let stopped = false;
+
+  async function passForChain(ctx: ChainContext, summary: PassSummary): Promise<void> {
+    const candidates = await discover({
+      ctx,
+      config,
+      store,
+      openseaApiKey: secrets.openseaApiKey,
+    });
+    summary.discovered += candidates.length;
+
+    const { keep, dropped } = filterCandidates(candidates, config, store);
+    if (dropped.length > 0) {
+      log.debug('candidates filtered out', { chain: ctx.cfg.name, count: dropped.length });
+    }
+    if (keep.length === 0) return;
+
+    const fees = await resolveFees(ctx.public, config.mint.maxPriorityFeeGwei);
+
+    for (const candidate of keep) {
+      if (stopped) return;
+
+      // Re-checked per candidate so the kill switch takes effect immediately.
+      if (killSwitchEngaged(config.killSwitchPath)) {
+        log.warn('kill switch present — not minting', { path: config.killSwitchPath });
+        return;
+      }
+
+      summary.screened += 1;
+      let result;
+      try {
+        result = await screen(candidate, { ctx, config, store, fees });
+      } catch (err) {
+        log.warn('screening failed', {
+          contract: candidate.contract,
+          err: shortError(err),
+        });
+        continue;
+      }
+
+      if (result.rejections.length > 0 || !result.plan) {
+        summary.rejected += 1;
+        log.info('skipping', {
+          chain: ctx.cfg.name,
+          contract: candidate.contract,
+          name: result.info.name ?? candidate.name,
+          reasons: result.rejections,
+        });
+        store.recordAttempt(candidate.chainId, candidate.contract, {
+          status: 'rejected',
+          at: Date.now(),
+          reason: result.rejections.join('; ') || 'no mint plan',
+        });
+        continue;
+      }
+
+      // Prefer the on-chain name; discovery often has none.
+      candidate.name = result.info.name ?? candidate.name;
+
+      log.info('free mint found', {
+        chain: ctx.cfg.name,
+        contract: candidate.contract,
+        name: candidate.name,
+        standard: result.info.standard,
+        route: result.plan.label,
+        source: candidate.source,
+      });
+
+      const record = await executeMint(candidate, result.plan, { ctx, config, store, fees });
+      store.recordAttempt(candidate.chainId, candidate.contract, record);
+
+      if (record.status === 'minted') summary.minted += 1;
+      else if (record.status === 'dry-run') summary.dryRun += 1;
+      else if (record.status === 'failed') summary.failed += 1;
+    }
+  }
+
+  async function runOnce(): Promise<PassSummary> {
+    const summary = { ...EMPTY_SUMMARY };
+
+    for (const ctx of contexts) {
+      if (stopped) break;
+      try {
+        await passForChain(ctx, summary);
+      } catch (err) {
+        log.warn('pass failed for chain', { chain: ctx.cfg.name, err: shortError(err) });
+      }
+    }
+
+    store.flush();
+    return summary;
+  }
+
+  async function runForever(): Promise<void> {
+    log.info('automint started', {
+      dryRun: config.dryRun,
+      canSend: contexts.some((c) => c.canSend),
+      wallet: contexts[0]?.account,
+      chains: contexts.map((c) => c.cfg.name).join(','),
+      pollIntervalMs: config.pollIntervalMs,
+    });
+
+    if (config.dryRun) {
+      log.warn('dryRun is enabled — no transactions will be sent (set AUTOMINT_DRY_RUN=false to go live)');
+    }
+
+    while (!stopped) {
+      const started = Date.now();
+      const summary = await runOnce();
+      log.info('pass complete', { ...summary, ms: Date.now() - started });
+
+      const elapsed = Date.now() - started;
+      const wait = Math.max(0, config.pollIntervalMs - elapsed);
+      if (wait > 0) await sleep(wait, () => stopped);
+    }
+
+    log.info('automint stopped');
+  }
+
+  return {
+    runOnce,
+    runForever,
+    stop: () => {
+      stopped = true;
+    },
+    contexts,
+    store,
+  };
+}
+
+/** Interruptible sleep so Ctrl-C doesn't have to wait out the poll interval. */
+function sleep(ms: number, cancelled: () => boolean): Promise<void> {
+  return new Promise((resolve) => {
+    const step = 250;
+    let waited = 0;
+    const timer = setInterval(() => {
+      waited += step;
+      if (waited >= ms || cancelled()) {
+        clearInterval(timer);
+        resolve();
+      }
+    }, step);
+  });
+}
diff --git a/src/screening/index.ts b/src/screening/index.ts
new file mode 100644
index 0000000..5594180
--- /dev/null
+++ b/src/screening/index.ts
@@ -0,0 +1,99 @@
+import { checkGasBudget } from '../budget';
+import type { ChainContext } from '../chains';
+import type { Config } from '../config';
+import { resolveFees, worstCaseGasCost, type Fees } from '../execute/fees';
+import { simulateMint } from '../execute/simulate';
+import { log } from '../logger';
+import type { Store } from '../state/store';
+import type { Candidate, ScreenResult } from '../types';
+import { inspectContract } from './interfaces';
+import { findMintPlan } from './mintPlan';
+
+export interface ScreenDeps {
+  ctx: ChainContext;
+  config: Config;
+  store: Store;
+  /** Reused across a batch so we make one fee call per pass, not one per candidate. */
+  fees: Fees;
+}
+
+/**
+ * Decides whether a candidate is a free, currently-mintable collection and, if
+ * so, exactly what transaction to send.
+ *
+ * Every gate here is a reason to *not* spend gas. The order is cheapest check
+ * first: contract shape, then route probing, then budget, then full simulation.
+ */
+export async function screen(candidate: Candidate, deps: ScreenDeps): Promise<ScreenResult> {
+  const { ctx, config, store, fees } = deps;
+  const rejections: string[] = [];
+
+  const info = await inspectContract(ctx.public, candidate.contract);
+
+  if (!info.hasCode) {
+    return { candidate, info, rejections: ['address has no bytecode'] };
+  }
+  if (info.standard === 'unknown') {
+    return {
+      candidate,
+      info,
+      rejections: ['not recognisable as ERC-721 or ERC-1155'],
+    };
+  }
+
+  const { plan, tried } = await findMintPlan({
+    client: ctx.public,
+    nft: candidate.contract,
+    minter: ctx.account,
+    quantity: config.mint.quantity,
+    standard: info.standard,
+    maxGasUnits: config.mint.maxGasUnits,
+  });
+
+  if (!plan) {
+    log.debug('no free mint route', {
+      contract: candidate.contract,
+      routesTried: tried.length,
+      sample: tried.slice(0, 3),
+    });
+    return {
+      candidate,
+      info,
+      rejections: [`no zero-value mint route succeeded (${tried.length} routes tried)`],
+    };
+  }
+
+  const gasCost = worstCaseGasCost(plan.gasEstimate, fees);
+  const budget = checkGasBudget(store, ctx.cfg, gasCost);
+  if (!budget.allowed) {
+    rejections.push(budget.reason ?? 'gas budget check failed');
+  }
+
+  if (config.mint.requireTransferToSelf) {
+    const outcome = await simulateMint(ctx.public, plan, ctx.account);
+    if (outcome.kind === 'reverted') {
+      rejections.push(`simulation reverted: ${outcome.reason}`);
+    } else if (outcome.kind === 'ok' && !outcome.receivesToken) {
+      rejections.push('simulation shows no token transferred to our address');
+    } else if (outcome.kind === 'unsupported') {
+      // estimateGas already proved the call executes; we just lose the
+      // stronger "we actually receive it" guarantee.
+      log.debug('eth_simulateV1 unavailable, relying on gas estimation only', {
+        chain: ctx.cfg.name,
+      });
+    }
+  }
+
+  return { candidate, info, rejections, plan };
+}
+
+/** Convenience wrapper for one-off screening (the `check` CLI command). */
+export async function screenOne(
+  candidate: Candidate,
+  ctx: ChainContext,
+  config: Config,
+  store: Store,
+): Promise<ScreenResult> {
+  const fees = await resolveFees(ctx.public, config.mint.maxPriorityFeeGwei);
+  return screen(candidate, { ctx, config, store, fees });
+}
