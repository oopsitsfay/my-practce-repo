@@ -0,0 +1,105 @@
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { enabledChains, loadConfig } from '../src/config';
+
+const VALID = {
+  chains: [
+    {
+      id: 8453,
+      name: 'base',
+      rpcUrl: 'https://mainnet.base.org',
+      enabled: true,
+      maxGasCostWei: '200000000000000',
+      dailyGasBudgetWei: '2000000000000000',
+    },
+    {
+      id: 1,
+      name: 'ethereum',
+      rpcUrl: 'https://eth.example',
+      enabled: false,
+      maxGasCostWei: '1',
+      dailyGasBudgetWei: '1',
+    },
+  ],
+};
+
+const REAL_KEY = `0x${'1'.repeat(64)}`;
+
+function writeConfig(body: unknown): string {
+  const dir = mkdtempSync(join(tmpdir(), 'automint-config-'));
+  writeFileSync(join(dir, 'automint.config.json'), JSON.stringify(body), 'utf8');
+  return dir;
+}
+
+describe('loadConfig', () => {
+  const saved = { ...process.env };
+
+  beforeEach(() => {
+    delete process.env.AUTOMINT_DRY_RUN;
+    delete process.env.AUTOMINT_PRIVATE_KEY;
+    delete process.env.AUTOMINT_SIMULATION_ADDRESS;
+    delete process.env.OPENSEA_API_KEY;
+  });
+
+  afterEach(() => {
+    process.env = { ...saved };
+  });
+
+  it('applies defaults and parses wei strings into bigints', () => {
+    const { config } = loadConfig({ cwd: writeConfig(VALID) });
+    expect(config.dryRun).toBe(true);
+    expect(config.mint.quantity).toBe(1);
+    expect(config.chains[0]?.maxGasCostWei).toBe(200_000_000_000_000n);
+  });
+
+  it('returns only enabled chains from enabledChains', () => {
+    const { config } = loadConfig({ cwd: writeConfig(VALID) });
+    expect(enabledChains(config).map((c) => c.name)).toEqual(['base']);
+  });
+
+  it('throws a readable error when the file is missing', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'automint-empty-'));
+    expect(() => loadConfig({ cwd: dir })).toThrow(/config not found/);
+  });
+
+  it('rejects a non-numeric wei value', () => {
+    const dir = writeConfig({
+      chains: [{ ...VALID.chains[0], maxGasCostWei: '0.5' }],
+    });
+    expect(() => loadConfig({ cwd: dir })).toThrow(/decimal wei string/);
+  });
+
+  it('rejects a config with no chains', () => {
+    expect(() => loadConfig({ cwd: writeConfig({ chains: [] }) })).toThrow(/invalid/);
+  });
+
+  it('lets AUTOMINT_DRY_RUN override the file', () => {
+    process.env.AUTOMINT_PRIVATE_KEY = REAL_KEY;
+    process.env.AUTOMINT_DRY_RUN = 'false';
+    expect(loadConfig({ cwd: writeConfig({ ...VALID, dryRun: true }) }).config.dryRun).toBe(false);
+  });
+
+  it('refuses to run live without a private key', () => {
+    process.env.AUTOMINT_DRY_RUN = 'false';
+    expect(() => loadConfig({ cwd: writeConfig(VALID) })).toThrow(/refusing to start/);
+  });
+
+  it('treats the all-zero placeholder key as absent', () => {
+    process.env.AUTOMINT_PRIVATE_KEY = `0x${'0'.repeat(64)}`;
+    const { secrets } = loadConfig({ cwd: writeConfig(VALID) });
+    expect(secrets.privateKey).toBeUndefined();
+  });
+
+  it('rejects a malformed private key', () => {
+    process.env.AUTOMINT_PRIVATE_KEY = '0xnope';
+    expect(() => loadConfig({ cwd: writeConfig(VALID) })).toThrow(/64 hex characters/);
+  });
+
+  it('checksums the simulation address', () => {
+    process.env.AUTOMINT_SIMULATION_ADDRESS = '0x000000000000000000000000000000000000dead';
+    const { secrets } = loadConfig({ cwd: writeConfig(VALID) });
+    expect(secrets.simulationAddress).toBe('0x000000000000000000000000000000000000dEaD');
+  });
+});
diff --git a/tests/filter.test.ts b/tests/filter.test.ts
new file mode 100644
index 0000000..a8edbc8
--- /dev/null
+++ b/tests/filter.test.ts
@@ -0,0 +1,107 @@
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { filterCandidates } from '../src/discovery/index';
+import type { Config } from '../src/config';
+import { Store } from '../src/state/store';
+import type { Address, Candidate } from '../src/types';
+
+const A = '0xAAaAaAaAAaAAAaAAaAAAAaaaaAaaaAaaAaAAAAaA' as Address;
+const B = '0xbBBbBBBbbBBBbbbBbbBbbbbbBBbBbbbbBbBbBBbb' as Address;
+
+const NOW = 1_800_000_000_000;
+
+function baseConfig(over: Partial<Config> = {}): Config {
+  return {
+    dryRun: true,
+    pollIntervalMs: 15_000,
+    statePath: '.automint/state.json',
+    killSwitchPath: '.automint/STOP',
+    chains: [],
+    mint: {
+      quantity: 1,
+      maxAgeSeconds: 3600,
+      confirmations: 1,
+      maxGasUnits: 500_000,
+      maxPriorityFeeGwei: 1.5,
+      requireTransferToSelf: true,
+    },
+    discovery: {
+      opensea: { enabled: false, limit: 50 },
+      onchain: { enabled: true, blockLookback: 60, maxCandidatesPerScan: 40 },
+    },
+    denylist: [],
+    allowlist: [],
+    allowlistOnly: false,
+    ...over,
+  } as Config;
+}
+
+function candidate(contract: Address, over: Partial<Candidate> = {}): Candidate {
+  return {
+    chainId: 8453,
+    contract,
+    source: 'onchain',
+    discoveredAt: NOW,
+    liveAt: NOW,
+    ...over,
+  };
+}
+
+function freshStore(): Store {
+  return Store.open('state.json', mkdtempSync(join(tmpdir(), 'automint-filter-')));
+}
+
+describe('filterCandidates', () => {
+  it('keeps a fresh, unseen, unlisted candidate', () => {
+    const { keep } = filterCandidates([candidate(A)], baseConfig(), freshStore(), NOW);
+    expect(keep.map((c) => c.contract)).toEqual([A]);
+  });
+
+  it('drops denylisted contracts regardless of case', () => {
+    const config = baseConfig({ denylist: [A] });
+    const { keep, dropped } = filterCandidates(
+      [candidate(A.toLowerCase() as Address)],
+      config,
+      freshStore(),
+      NOW,
+    );
+    expect(keep).toHaveLength(0);
+    expect(dropped[0]?.reason).toBe('on denylist');
+  });
+
+  it('drops everything not allowlisted when allowlistOnly is set', () => {
+    const config = baseConfig({ allowlistOnly: true, allowlist: [B] });
+    const { keep } = filterCandidates([candidate(A), candidate(B)], config, freshStore(), NOW);
+    expect(keep.map((c) => c.contract)).toEqual([B]);
+  });
+
+  it('drops contracts that went live outside the freshness window', () => {
+    const config = baseConfig();
+    const stale = candidate(A, { liveAt: NOW - 7200 * 1000 });
+    const { keep, dropped } = filterCandidates([stale], config, freshStore(), NOW);
+    expect(keep).toHaveLength(0);
+    expect(dropped[0]?.reason).toContain('maxAgeSeconds');
+  });
+
+  it('falls back to discoveredAt when the source gave no live time', () => {
+    const config = baseConfig();
+    const c = candidate(A, { liveAt: undefined, discoveredAt: NOW - 10_000 });
+    expect(filterCandidates([c], config, freshStore(), NOW).keep).toHaveLength(1);
+  });
+
+  it('drops contracts already settled in the store', () => {
+    const store = freshStore();
+    store.recordAttempt(8453, A, { status: 'minted', at: NOW });
+    const { keep, dropped } = filterCandidates([candidate(A)], baseConfig(), store, NOW);
+    expect(keep).toHaveLength(0);
+    expect(dropped[0]?.reason).toBe('already handled');
+  });
+
+  it('retries a contract whose previous attempt merely failed', () => {
+    const store = freshStore();
+    store.recordAttempt(8453, A, { status: 'failed', at: NOW });
+    expect(filterCandidates([candidate(A)], baseConfig(), store, NOW).keep).toHaveLength(1);
+  });
+});
diff --git a/tests/helpers/mockNode.ts b/tests/helpers/mockNode.ts
new file mode 100644
index 0000000..45e401c
--- /dev/null
+++ b/tests/helpers/mockNode.ts
@@ -0,0 +1,240 @@
+import { createServer, type Server } from 'node:http';
+import {
+  encodeEventTopics,
+  encodeFunctionResult,
+  numberToHex,
+  pad,
+  parseAbi,
+  parseAbiItem,
+  toFunctionSelector,
+  zeroAddress,
+  type Address,
+  type Hex,
+} from 'viem';
+
+const ABI = parseAbi([
+  'function supportsInterface(bytes4) view returns (bool)',
+  'function name() view returns (string)',
+  'function symbol() view returns (string)',
+  'function totalSupply() view returns (uint256)',
+]);
+
+const SELECTORS = {
+  supportsInterface: toFunctionSelector('supportsInterface(bytes4)'),
+  name: toFunctionSelector('name()'),
+  symbol: toFunctionSelector('symbol()'),
+  totalSupply: toFunctionSelector('totalSupply()'),
+} as const;
+
+const [TRANSFER_TOPIC] = encodeEventTopics({
+  abi: [parseAbiItem('event Transfer(address indexed from, address indexed to, uint256 indexed tokenId)')],
+  eventName: 'Transfer',
+});
+
+export interface MockNodeOptions {
+  /** The NFT contract this node pretends to host. */
+  contract: Address;
+  /** ERC-165 id the contract claims to support, or none. */
+  interfaceId?: Hex;
+  /** Function selectors that `eth_estimateGas` accepts; everything else reverts. */
+  mintableSelectors: Hex[];
+  gasEstimate?: bigint;
+  /** Who the simulated mint sends the token to. Omit for "nobody". */
+  simulationRecipient?: Address;
+  /** Make eth_simulateV1 report "method not found". */
+  simulateUnsupported?: boolean;
+  baseFeePerGas?: bigint;
+  /** Contracts that `eth_getLogs` should report as having just minted. */
+  mintingContracts?: Address[];
+}
+
+export interface MockNode {
+  url: string;
+  close: () => Promise<void>;
+  /** Every RPC method the client called, in order. */
+  calls: string[];
+}
+
+function block(baseFeePerGas: bigint) {
+  return {
+    number: numberToHex(1_000_000n),
+    hash: pad('0x01', { size: 32 }),
+    parentHash: pad('0x00', { size: 32 }),
+    nonce: '0x0000000000000000',
+    sha3Uncles: pad('0x00', { size: 32 }),
+    logsBloom: pad('0x00', { size: 256 }),
+    transactionsRoot: pad('0x00', { size: 32 }),
+    stateRoot: pad('0x00', { size: 32 }),
+    receiptsRoot: pad('0x00', { size: 32 }),
+    miner: zeroAddress,
+    difficulty: '0x0',
+    totalDifficulty: '0x0',
+    extraData: '0x',
+    size: '0x0',
+    gasLimit: numberToHex(30_000_000n),
+    gasUsed: numberToHex(1_000_000n),
+    timestamp: numberToHex(BigInt(Math.floor(Date.now() / 1000))),
+    transactions: [],
+    uncles: [],
+    baseFeePerGas: numberToHex(baseFeePerGas),
+  };
+}
+
+/**
+ * Minimal JSON-RPC node, enough to exercise the real viem client path end to
+ * end without touching a network. Handles viem's batched requests too.
+ */
+export async function startMockNode(options: MockNodeOptions): Promise<MockNode> {
+  const gasEstimate = options.gasEstimate ?? 100_000n;
+  const baseFee = options.baseFeePerGas ?? 1_000_000_000n;
+  const mintable = new Set(options.mintableSelectors.map((s) => s.toLowerCase()));
+  const calls: string[] = [];
+
+  const handle = (req: { method: string; params?: unknown[]; id?: unknown }): unknown => {
+    calls.push(req.method);
+    const reply = (result: unknown) => ({ jsonrpc: '2.0', id: req.id ?? null, result });
+    const revert = (message = 'execution reverted') => ({
+      jsonrpc: '2.0',
+      id: req.id ?? null,
+      error: { code: 3, message },
+    });
+
+    switch (req.method) {
+      case 'eth_chainId':
+        return reply(numberToHex(31337));
+      case 'eth_blockNumber':
+        return reply(numberToHex(1_000_000n));
+      case 'eth_getBlockByNumber':
+      case 'eth_getBlockByHash':
+        return reply(block(baseFee));
+      case 'eth_maxPriorityFeePerGas':
+        return reply(numberToHex(500_000_000n));
+      case 'eth_getBalance':
+        return reply(numberToHex(10n ** 18n));
+
+      case 'eth_getLogs': {
+        const filter = req.params?.[0] as { topics?: (Hex | null)[] } | undefined;
+        const topic0 = filter?.topics?.[0];
+        // Only the ERC-721 Transfer sweep gets hits; the ERC-1155 sweep finds none.
+        if (!topic0 || topic0.toLowerCase() !== TRANSFER_TOPIC.toLowerCase()) return reply([]);
+        return reply(
+          (options.mintingContracts ?? []).map((address, index) => ({
+            address,
+            topics: [
+              TRANSFER_TOPIC,
+              pad(zeroAddress, { size: 32 }),
+              pad('0xdead', { size: 32 }),
+              pad('0x01', { size: 32 }),
+            ],
+            data: '0x',
+            blockNumber: numberToHex(999_999n),
+            blockHash: pad('0x01', { size: 32 }),
+            transactionHash: pad('0x02', { size: 32 }),
+            transactionIndex: numberToHex(0),
+            logIndex: numberToHex(index),
+            removed: false,
+          })),
+        );
+      }
+
+      case 'eth_getCode': {
+        const address = String(req.params?.[0] ?? '').toLowerCase();
+        return reply(address === options.contract.toLowerCase() ? '0x60806040' : '0x');
+      }
+
+      case 'eth_call': {
+        const call = req.params?.[0] as { to?: string; data?: Hex } | undefined;
+        const to = String(call?.to ?? '').toLowerCase();
+        const data = (call?.data ?? '0x') as Hex;
+        if (to !== options.contract.toLowerCase()) return revert('no contract');
+
+        const selector = data.slice(0, 10).toLowerCase();
+        if (selector === SELECTORS.supportsInterface) {
+          const asked = `0x${data.slice(10, 18)}`.toLowerCase();
+          const supported = !!options.interfaceId && asked === options.interfaceId.toLowerCase();
+          return reply(
+            encodeFunctionResult({ abi: ABI, functionName: 'supportsInterface', result: supported }),
+          );
+        }
+        if (selector === SELECTORS.name) {
+          return reply(encodeFunctionResult({ abi: ABI, functionName: 'name', result: 'Mock Drop' }));
+        }
+        if (selector === SELECTORS.symbol) {
+          return reply(encodeFunctionResult({ abi: ABI, functionName: 'symbol', result: 'MOCK' }));
+        }
+        if (selector === SELECTORS.totalSupply) {
+          return reply(
+            encodeFunctionResult({ abi: ABI, functionName: 'totalSupply', result: 42n }),
+          );
+        }
+        return revert();
+      }
+
+      case 'eth_estimateGas': {
+        const tx = req.params?.[0] as { to?: string; data?: Hex; value?: Hex } | undefined;
+        if (tx?.value !== undefined && BigInt(tx.value) !== 0n) return revert('unexpected value');
+        const selector = String(tx?.data ?? '0x').slice(0, 10).toLowerCase();
+        if (!mintable.has(selector)) return revert();
+        return reply(numberToHex(gasEstimate));
+      }
+
+      case 'eth_simulateV1': {
+        if (options.simulateUnsupported) {
+          return { jsonrpc: '2.0', id: req.id ?? null, error: { code: -32601, message: 'the method eth_simulateV1 does not exist' } };
+        }
+        const logs = options.simulationRecipient
+          ? [
+              {
+                address: options.contract,
+                topics: [
+                  TRANSFER_TOPIC,
+                  pad(zeroAddress, { size: 32 }),
+                  pad(options.simulationRecipient, { size: 32 }),
+                  pad('0x01', { size: 32 }),
+                ],
+                data: '0x',
+              },
+            ]
+          : [];
+        return reply([{ calls: [{ status: '0x1', gasUsed: numberToHex(gasEstimate), logs }] }]);
+      }
+
+      default:
+        return { jsonrpc: '2.0', id: req.id ?? null, error: { code: -32601, message: `unsupported: ${req.method}` } };
+    }
+  };
+
+  const server: Server = createServer((req, res) => {
+    let body = '';
+    req.on('data', (chunk) => {
+      body += chunk;
+    });
+    req.on('end', () => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(body);
+      } catch {
+        res.writeHead(400).end();
+        return;
+      }
+      const response = Array.isArray(parsed)
+        ? parsed.map((entry) => handle(entry as { method: string; params?: unknown[]; id?: unknown }))
+        : handle(parsed as { method: string; params?: unknown[]; id?: unknown });
+      res.writeHead(200, { 'content-type': 'application/json' });
+      res.end(JSON.stringify(response));
+    });
+  });
+
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const addr = server.address();
+  if (addr === null || typeof addr === 'string') throw new Error('mock node failed to bind');
+
+  return {
+    url: `http://127.0.0.1:${addr.port}`,
+    calls,
+    close: () =>
+      new Promise<void>((resolve, reject) =>
+        server.close((err) => (err ? reject(err) : resolve())),
+      ),
+  };
+}
diff --git a/tests/mintPlan.test.ts b/tests/mintPlan.test.ts
new file mode 100644
index 0000000..3687444
--- /dev/null
+++ b/tests/mintPlan.test.ts
@@ -0,0 +1,121 @@
+import { toFunctionSelector, type PublicClient } from 'viem';
+import { describe, expect, it } from 'vitest';
+import { buildCandidateCalls, findMintPlan } from '../src/screening/mintPlan';
+import type { Address, Hex } from '../src/types';
+
+const NFT = '0x1234567890123456789012345678901234567890' as Address;
+const MINTER = '0x000000000000000000000000000000000000dEaD' as Address;
+
+const SELECTOR_MINT_QTY = toFunctionSelector('mint(uint256)');
+const SELECTOR_PUBLIC_MINT = toFunctionSelector('publicMint(uint256)');
+
+/** No SeaDrop, and gas estimation driven by a per-selector table. */
+function stubClient(gasBySelector: Record<string, bigint | Error>): PublicClient {
+  return {
+    readContract: async () => {
+      throw new Error('no seadrop configured');
+    },
+    estimateGas: async ({ data }: { data: Hex }) => {
+      const selector = data.slice(0, 10).toLowerCase();
+      const outcome = gasBySelector[selector];
+      if (outcome === undefined) throw new Error('execution reverted');
+      if (outcome instanceof Error) throw outcome;
+      return outcome;
+    },
+  } as unknown as PublicClient;
+}
+
+describe('buildCandidateCalls', () => {
+  it('offers erc721 routes with mint(uint256) first', async () => {
+    const calls = await buildCandidateCalls(
+      stubClient({}),
+      NFT,
+      MINTER,
+      1,
+      'erc721',
+    );
+    expect(calls[0]?.label).toBe('mint(uint256 quantity)');
+    expect(calls[0]?.to).toBe(NFT);
+    expect(calls[0]?.data.startsWith(SELECTOR_MINT_QTY)).toBe(true);
+  });
+
+  it('does not offer erc1155-only routes to an erc721 contract', async () => {
+    const calls = await buildCandidateCalls(stubClient({}), NFT, MINTER, 1, 'erc721');
+    expect(calls.some((c) => c.label.includes('uint256 id'))).toBe(false);
+  });
+
+  it('offers erc1155 routes, including both common token ids', async () => {
+    const calls = await buildCandidateCalls(stubClient({}), NFT, MINTER, 1, 'erc1155');
+    const labels = calls.map((c) => c.label);
+    expect(labels).toContain('mint(uint256 id, uint256 quantity) id=0');
+    expect(labels).toContain('mint(uint256 id, uint256 quantity) id=1');
+  });
+
+  it('encodes the requested quantity into the calldata', async () => {
+    const [one] = await buildCandidateCalls(stubClient({}), NFT, MINTER, 1, 'erc721');
+    const [three] = await buildCandidateCalls(stubClient({}), NFT, MINTER, 3, 'erc721');
+    expect(one?.data).not.toBe(three?.data);
+    expect(three?.data.endsWith('3')).toBe(true);
+  });
+
+  it('offers no routes for an unrecognised standard', async () => {
+    expect(await buildCandidateCalls(stubClient({}), NFT, MINTER, 1, 'unknown')).toHaveLength(0);
+  });
+});
+
+describe('findMintPlan', () => {
+  const base = {
+    nft: NFT,
+    minter: MINTER,
+    quantity: 1,
+    standard: 'erc721' as const,
+    maxGasUnits: 500_000,
+  };
+
+  it('returns the first route the node accepts', async () => {
+    const client = stubClient({ [SELECTOR_PUBLIC_MINT]: 90_000n });
+    const { plan, tried } = await findMintPlan({ ...base, client });
+
+    expect(plan?.label).toBe('publicMint(uint256 quantity)');
+    expect(plan?.gasEstimate).toBe(90_000n);
+    expect(plan?.value).toBe(0n);
+    // mint(uint256) was tried first and rejected.
+    expect(tried[0]?.label).toBe('mint(uint256 quantity)');
+  });
+
+  it('always plans a zero-value call', async () => {
+    const client = stubClient({ [SELECTOR_MINT_QTY]: 80_000n });
+    const { plan } = await findMintPlan({ ...base, client });
+    expect(plan?.value).toBe(0n);
+  });
+
+  it('skips a route over the gas ceiling and takes a cheaper one', async () => {
+    const client = stubClient({
+      [SELECTOR_MINT_QTY]: 900_000n,
+      [SELECTOR_PUBLIC_MINT]: 100_000n,
+    });
+    const { plan, tried } = await findMintPlan({ ...base, client });
+
+    expect(plan?.label).toBe('publicMint(uint256 quantity)');
+    expect(tried.find((t) => t.label === 'mint(uint256 quantity)')?.reason).toContain(
+      'exceeds maxGasUnits',
+    );
+  });
+
+  it('returns no plan when every route reverts, and reports what it tried', async () => {
+    const { plan, tried } = await findMintPlan({ ...base, client: stubClient({}) });
+    expect(plan).toBeUndefined();
+    expect(tried.length).toBeGreaterThan(5);
+    expect(tried.every((t) => t.reason.length > 0)).toBe(true);
+  });
+
+  it('surfaces a paid mint as a rejection, since value is pinned to zero', async () => {
+    // A contract that requires payment reverts when simulated with value 0.
+    const client = stubClient({
+      [SELECTOR_MINT_QTY]: new Error('execution reverted: insufficient payment'),
+    });
+    const { plan, tried } = await findMintPlan({ ...base, client });
+    expect(plan).toBeUndefined();
+    expect(tried[0]?.reason).toContain('insufficient payment');
+  });
+});
diff --git a/tests/run.integration.test.ts b/tests/run.integration.test.ts
new file mode 100644
index 0000000..984efbe
