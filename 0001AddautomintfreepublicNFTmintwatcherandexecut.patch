+++ b/tests/run.integration.test.ts
@@ -0,0 +1,160 @@
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { toFunctionSelector } from 'viem';
+import { afterEach, describe, expect, it } from 'vitest';
+import type { Config, LoadedConfig } from '../src/config';
+import { createRunner } from '../src/run';
+import type { Address } from '../src/types';
+import { startMockNode, type MockNode } from './helpers/mockNode';
+
+const CONTRACT = '0x1234567890123456789012345678901234567890' as Address;
+const SIMULATION_FALLBACK = '0x000000000000000000000000000000000000dEaD' as Address;
+const SELECTOR_PUBLIC_MINT = toFunctionSelector('publicMint(uint256)');
+
+/** Absolute paths keep each run's state out of the repo and out of other tests. */
+function loaded(node: MockNode, over: Partial<Config> = {}): LoadedConfig {
+  const dir = mkdtempSync(join(tmpdir(), 'automint-run-'));
+  const config = {
+    dryRun: true,
+    pollIntervalMs: 15_000,
+    statePath: join(dir, 'state.json'),
+    killSwitchPath: join(dir, 'STOP'),
+    chains: [
+      {
+        id: 31337,
+        name: 'mock',
+        rpcUrl: node.url,
+        enabled: true,
+        nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
+        maxGasCostWei: 10n ** 18n,
+        dailyGasBudgetWei: 10n ** 18n,
+      },
+    ],
+    mint: {
+      quantity: 1,
+      maxAgeSeconds: 3600,
+      confirmations: 1,
+      maxGasUnits: 500_000,
+      maxPriorityFeeGwei: 1.5,
+      requireTransferToSelf: true,
+    },
+    discovery: {
+      opensea: { enabled: false, limit: 50 },
+      onchain: { enabled: true, blockLookback: 60, maxCandidatesPerScan: 40 },
+    },
+    denylist: [],
+    allowlist: [],
+    allowlistOnly: false,
+    ...over,
+  } as Config;
+
+  return { config, secrets: {}, path: join(dir, 'automint.config.json') };
+}
+
+let node: MockNode | undefined;
+
+afterEach(async () => {
+  await node?.close();
+  node = undefined;
+});
+
+describe('runOnce', () => {
+  it('discovers a minting contract, screens it, and dry-runs the mint', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node));
+    const summary = await runner.runOnce();
+
+    expect(summary.discovered).toBe(1);
+    expect(summary.screened).toBe(1);
+    expect(summary.dryRun).toBe(1);
+    expect(summary.minted).toBe(0);
+    expect(runner.store.getAttempt(31337, CONTRACT)?.status).toBe('dry-run');
+    expect(runner.store.getAttempt(31337, CONTRACT)?.label).toBe('publicMint(uint256 quantity)');
+  });
+
+  it('spends nothing from the gas budget in dry-run mode', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node));
+    await runner.runOnce();
+    expect(runner.store.spentToday(31337)).toBe(0n);
+  });
+
+  it('does not re-screen a contract it has already settled', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node));
+    expect((await runner.runOnce()).dryRun).toBe(1);
+
+    const second = await runner.runOnce();
+    expect(second.screened).toBe(0);
+    expect(second.dryRun).toBe(0);
+  });
+
+  it('records a rejection when nothing mints for free', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [],
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node));
+    const summary = await runner.runOnce();
+
+    expect(summary.rejected).toBe(1);
+    expect(summary.dryRun).toBe(0);
+    expect(runner.store.getAttempt(31337, CONTRACT)?.status).toBe('rejected');
+  });
+
+  it('honours the denylist before spending any RPC calls on screening', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node, { denylist: [CONTRACT] }));
+    const summary = await runner.runOnce();
+
+    expect(summary.discovered).toBe(1);
+    expect(summary.screened).toBe(0);
+    expect(node.calls).not.toContain('eth_estimateGas');
+  });
+
+  it('advances the block cursor so the next pass does not re-sweep', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: '0x80ac58cd',
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+      mintingContracts: [CONTRACT],
+    });
+
+    const runner = createRunner(loaded(node));
+    await runner.runOnce();
+    expect(runner.store.getCursor(31337)).toBe(1_000_000n);
+  });
+});
diff --git a/tests/screen.integration.test.ts b/tests/screen.integration.test.ts
new file mode 100644
index 0000000..f258b4a
--- /dev/null
+++ b/tests/screen.integration.test.ts
@@ -0,0 +1,209 @@
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { toFunctionSelector } from 'viem';
+import { afterEach, describe, expect, it } from 'vitest';
+import { makeChainContext, type ChainContext } from '../src/chains';
+import type { ChainConfig, Config } from '../src/config';
+import { screenOne } from '../src/screening/index';
+import { Store } from '../src/state/store';
+import type { Address, Candidate } from '../src/types';
+import { startMockNode, type MockNode } from './helpers/mockNode';
+
+const CONTRACT = '0x1234567890123456789012345678901234567890' as Address;
+const INTERFACE_ID_ERC721 = '0x80ac58cd';
+/** chains.ts uses this as the `from` address when no private key is configured. */
+const SIMULATION_FALLBACK = '0x000000000000000000000000000000000000dEaD' as Address;
+
+const SELECTOR_PUBLIC_MINT = toFunctionSelector('publicMint(uint256)');
+const SELECTOR_MINT_QTY = toFunctionSelector('mint(uint256)');
+
+function chainConfig(rpcUrl: string, over: Partial<ChainConfig> = {}): ChainConfig {
+  return {
+    id: 31337,
+    name: 'mock',
+    rpcUrl,
+    enabled: true,
+    nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
+    maxGasCostWei: 10n ** 18n,
+    dailyGasBudgetWei: 10n ** 18n,
+    ...over,
+  };
+}
+
+function appConfig(over: Partial<Config['mint']> = {}): Config {
+  return {
+    dryRun: true,
+    pollIntervalMs: 15_000,
+    statePath: '.automint/state.json',
+    killSwitchPath: '.automint/STOP',
+    chains: [],
+    mint: {
+      quantity: 1,
+      maxAgeSeconds: 3600,
+      confirmations: 1,
+      maxGasUnits: 500_000,
+      maxPriorityFeeGwei: 1.5,
+      requireTransferToSelf: true,
+      ...over,
+    },
+    discovery: {
+      opensea: { enabled: false, limit: 50 },
+      onchain: { enabled: true, blockLookback: 60, maxCandidatesPerScan: 40 },
+    },
+    denylist: [],
+    allowlist: [],
+    allowlistOnly: false,
+  } as Config;
+}
+
+function candidate(contract: Address = CONTRACT): Candidate {
+  return {
+    chainId: 31337,
+    contract,
+    source: 'manual',
+    discoveredAt: Date.now(),
+    liveAt: Date.now(),
+  };
+}
+
+function freshStore(): Store {
+  return Store.open('state.json', mkdtempSync(join(tmpdir(), 'automint-int-')));
+}
+
+function context(node: MockNode, over: Partial<ChainConfig> = {}): ChainContext {
+  return makeChainContext(chainConfig(node.url, over), {});
+}
+
+let node: MockNode | undefined;
+
+afterEach(async () => {
+  await node?.close();
+  node = undefined;
+});
+
+describe('screening against a live JSON-RPC node', () => {
+  it('finds the free route, confirms the transfer, and returns a zero-value plan', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+    });
+
+    const result = await screenOne(candidate(), context(node), appConfig(), freshStore());
+
+    expect(result.rejections).toEqual([]);
+    expect(result.info.standard).toBe('erc721');
+    expect(result.info.name).toBe('Mock Drop');
+    expect(result.info.symbol).toBe('MOCK');
+    expect(result.info.totalSupply).toBe(42n);
+    expect(result.plan?.label).toBe('publicMint(uint256 quantity)');
+    expect(result.plan?.to).toBe(CONTRACT);
+    expect(result.plan?.value).toBe(0n);
+    expect(result.plan?.gasEstimate).toBe(100_000n);
+    expect(node.calls).toContain('eth_simulateV1');
+  });
+
+  it('rejects an address with no bytecode without probing routes', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_PUBLIC_MINT],
+      simulationRecipient: SIMULATION_FALLBACK,
+    });
+
+    const other = '0x9999999999999999999999999999999999999999' as Address;
+    const result = await screenOne(candidate(other), context(node), appConfig(), freshStore());
+
+    expect(result.rejections).toEqual(['address has no bytecode']);
+    expect(result.plan).toBeUndefined();
+    expect(node.calls).not.toContain('eth_estimateGas');
+  });
+
+  it('rejects a contract where no route mints for free', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [],
+      simulationRecipient: SIMULATION_FALLBACK,
+    });
+
+    const result = await screenOne(candidate(), context(node), appConfig(), freshStore());
+
+    expect(result.plan).toBeUndefined();
+    expect(result.rejections[0]).toContain('no zero-value mint route succeeded');
+  });
+
+  it('rejects a mint that does not deliver a token to us', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_MINT_QTY],
+      simulationRecipient: undefined,
+    });
+
+    const result = await screenOne(candidate(), context(node), appConfig(), freshStore());
+
+    expect(result.plan).toBeDefined();
+    expect(result.rejections).toContain('simulation shows no token transferred to our address');
+  });
+
+  it('accepts the mint anyway when the node lacks eth_simulateV1', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_MINT_QTY],
+      simulateUnsupported: true,
+    });
+
+    const result = await screenOne(candidate(), context(node), appConfig(), freshStore());
+
+    expect(result.rejections).toEqual([]);
+    expect(result.plan?.label).toBe('mint(uint256 quantity)');
+  });
+
+  it('skips the transfer check entirely when requireTransferToSelf is off', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_MINT_QTY],
+      simulationRecipient: undefined,
+    });
+
+    const config = appConfig({ requireTransferToSelf: false });
+    const result = await screenOne(candidate(), context(node), config, freshStore());
+
+    expect(result.rejections).toEqual([]);
+    expect(node.calls).not.toContain('eth_simulateV1');
+  });
+
+  it('rejects when the per-mint gas cost exceeds the chain cap', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: INTERFACE_ID_ERC721,
+      mintableSelectors: [SELECTOR_MINT_QTY],
+      simulationRecipient: SIMULATION_FALLBACK,
+    });
+
+    const ctx = context(node, { maxGasCostWei: 1n });
+    const result = await screenOne(candidate(), ctx, appConfig(), freshStore());
+
+    expect(result.rejections.some((r) => r.includes('per-mint cap'))).toBe(true);
+  });
+
+  it('falls back to balanceOf when the contract has no ERC-165', async () => {
+    node = await startMockNode({
+      contract: CONTRACT,
+      interfaceId: undefined,
+      mintableSelectors: [SELECTOR_MINT_QTY],
+      simulationRecipient: SIMULATION_FALLBACK,
+    });
+
+    const result = await screenOne(candidate(), context(node), appConfig(), freshStore());
+
+    // Our mock reverts balanceOf, so the standard stays unknown and we bail out.
+    expect(result.info.standard).toBe('unknown');
+    expect(result.rejections).toEqual(['not recognisable as ERC-721 or ERC-1155']);
+  });
+});
diff --git a/tests/store.test.ts b/tests/store.test.ts
new file mode 100644
index 0000000..f27cea6
--- /dev/null
+++ b/tests/store.test.ts
@@ -0,0 +1,94 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { Store } from '../src/state/store';
+import type { Address } from '../src/types';
+
+const CONTRACT = '0x1111111111111111111111111111111111111111' as Address;
+
+describe('Store', () => {
+  let dir: string;
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'automint-store-'));
+  });
+
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  it('starts empty when the file does not exist', () => {
+    const store = Store.open('state.json', dir);
+    expect(store.summary().attempts).toBe(0);
+    expect(store.spentToday(8453)).toBe(0n);
+    expect(store.getCursor(8453)).toBeUndefined();
+  });
+
+  it('round-trips attempts, spend and cursors through disk', () => {
+    const store = Store.open('nested/state.json', dir);
+    store.recordAttempt(8453, CONTRACT, { status: 'minted', at: 1, txHash: '0xabc' });
+    store.addSpend(8453, 1_500n);
+    store.setCursor(8453, 12345n);
+    store.flush();
+
+    const reopened = Store.open('nested/state.json', dir);
+    expect(reopened.getAttempt(8453, CONTRACT)?.status).toBe('minted');
+    expect(reopened.spentToday(8453)).toBe(1_500n);
+    expect(reopened.getCursor(8453)).toBe(12345n);
+  });
+
+  it('is case-insensitive about contract addresses', () => {
+    const store = Store.open('state.json', dir);
+    store.recordAttempt(8453, CONTRACT.toUpperCase() as Address, { status: 'minted', at: 1 });
+    expect(store.isSettled(8453, CONTRACT.toLowerCase() as Address)).toBe(true);
+  });
+
+  it('keys attempts by chain, so the same contract on two chains is distinct', () => {
+    const store = Store.open('state.json', dir);
+    store.recordAttempt(8453, CONTRACT, { status: 'minted', at: 1 });
+    expect(store.isSettled(8453, CONTRACT)).toBe(true);
+    expect(store.isSettled(1, CONTRACT)).toBe(false);
+  });
+
+  it('treats minted, dry-run and rejected as settled but leaves failures retryable', () => {
+    const store = Store.open('state.json', dir);
+    const cases: Array<[Address, 'minted' | 'dry-run' | 'rejected' | 'failed', boolean]> = [
+      ['0xaa00000000000000000000000000000000000000' as Address, 'minted', true],
+      ['0xbb00000000000000000000000000000000000000' as Address, 'dry-run', true],
+      ['0xcc00000000000000000000000000000000000000' as Address, 'rejected', true],
+      ['0xdd00000000000000000000000000000000000000' as Address, 'failed', false],
+    ];
+    for (const [addr, status, settled] of cases) {
+      store.recordAttempt(1, addr, { status, at: 1 });
+      expect(store.isSettled(1, addr), status).toBe(settled);
+    }
+  });
+
+  it('accumulates spend per UTC day and per chain', () => {
+    const store = Store.open('state.json', dir);
+    const monday = new Date('2026-07-27T10:00:00Z');
+    const tuesday = new Date('2026-07-28T10:00:00Z');
+
+    store.addSpend(8453, 100n, monday);
+    store.addSpend(8453, 250n, monday);
+    store.addSpend(8453, 7n, tuesday);
+    store.addSpend(1, 5n, monday);
+
+    expect(store.spentToday(8453, monday)).toBe(350n);
+    expect(store.spentToday(8453, tuesday)).toBe(7n);
+    expect(store.spentToday(1, monday)).toBe(5n);
+  });
+
+  it('recovers from a corrupt state file rather than throwing', () => {
+    const store = Store.open('state.json', dir);
+    store.addSpend(1, 1n);
+    store.flush();
+
+    // Simulate a truncated write.
+    writeFileSync(join(dir, 'state.json'), '{"attempts":', 'utf8');
+
+    const reopened = Store.open('state.json', dir);
+    expect(reopened.summary().attempts).toBe(0);
+  });
+});
