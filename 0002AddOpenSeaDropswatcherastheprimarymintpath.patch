@@ -0,0 +1,243 @@
+import { parseEther } from 'viem';
+import { describe, expect, it } from 'vitest';
+import { evaluateDrop, isInActiveWindow, stageKey } from '../src/drops/parser';
+import {
+  classifyStage,
+  normalizeDrop,
+  parsePriceToWei,
+  parseTimeToSeconds,
+  type NormalizedDrop,
+} from '../src/opensea/drops';
+
+const NOW = 1_800_000_000;
+
+function drop(over: Partial<NormalizedDrop> = {}): NormalizedDrop {
+  return {
+    slug: 'cool-drop',
+    name: 'Cool Drop',
+    chain: 'ethereum',
+    stages: [{ kind: 'public', label: 'Public', mintPriceWei: 0n, startTime: NOW - 10 }],
+    ...over,
+  };
+}
+
+const opts = { chain: 'ethereum', maxMintPriceWei: 0n, quantity: 1, nowSeconds: NOW };
+
+describe('parsePriceToWei', () => {
+  it('reads wei strings, ETH decimal strings, and nested shapes', () => {
+    expect(parsePriceToWei('0')).toBe(0n);
+    expect(parsePriceToWei('1000000000000000000')).toBe(10n ** 18n);
+    expect(parsePriceToWei('0.05')).toBe(parseEther('0.05'));
+    expect(parsePriceToWei({ wei: '250' })).toBe(250n);
+    expect(parsePriceToWei({ value: '0' })).toBe(0n);
+    expect(parsePriceToWei(0)).toBe(0n);
+  });
+
+  it('returns undefined for unparseable input rather than guessing zero', () => {
+    expect(parsePriceToWei(undefined)).toBeUndefined();
+    expect(parsePriceToWei(null)).toBeUndefined();
+    expect(parsePriceToWei('free')).toBeUndefined();
+    expect(parsePriceToWei('')).toBeUndefined();
+  });
+});
+
+describe('parseTimeToSeconds', () => {
+  it('accepts seconds, milliseconds, numeric strings and ISO strings', () => {
+    expect(parseTimeToSeconds(NOW)).toBe(NOW);
+    expect(parseTimeToSeconds(NOW * 1000)).toBe(NOW);
+    expect(parseTimeToSeconds(String(NOW))).toBe(NOW);
+    expect(parseTimeToSeconds('2026-07-29T00:00:00Z')).toBe(Math.floor(Date.parse('2026-07-29T00:00:00Z') / 1000));
+  });
+
+  it('returns undefined for junk', () => {
+    expect(parseTimeToSeconds('soon')).toBeUndefined();
+    expect(parseTimeToSeconds(undefined)).toBeUndefined();
+  });
+});
+
+describe('classifyStage', () => {
+  it('recognises public and allowlist labels case-insensitively', () => {
+    expect(classifyStage('Public')).toBe('public');
+    expect(classifyStage('PUBLIC SALE')).toBe('public');
+    expect(classifyStage('Allowlist')).toBe('allowlist');
+    expect(classifyStage('presale')).toBe('allowlist');
+    expect(classifyStage('VIP')).toBe('allowlist');
+    expect(classifyStage('something else')).toBe('unknown');
+    expect(classifyStage(undefined)).toBe('unknown');
+  });
+});
+
+describe('normalizeDrop', () => {
+  it('handles snake_case payloads', () => {
+    const normalized = normalizeDrop({
+      collection_slug: 'snake-drop',
+      chain: 'Ethereum',
+      total_supply: 10,
+      max_supply: 100,
+      contract_address: '0x1234567890123456789012345678901234567890',
+      stages: [{ stage_type: 'Public', mint_price: '0', start_time: NOW, max_per_wallet: 3 }],
+    });
+
+    expect(normalized?.slug).toBe('snake-drop');
+    expect(normalized?.chain).toBe('ethereum');
+    expect(normalized?.totalSupply).toBe(10);
+    expect(normalized?.maxSupply).toBe(100);
+    expect(normalized?.contract).toBe('0x1234567890123456789012345678901234567890');
+    expect(normalized?.stages[0]).toMatchObject({ kind: 'public', mintPriceWei: 0n, maxPerWallet: 3 });
+  });
+
+  it('handles camelCase payloads', () => {
+    const normalized = normalizeDrop({
+      collection: 'camel-drop',
+      stages: [{ stage: 'Public', mintPrice: { wei: '0' }, startTime: NOW }],
+    });
+    expect(normalized?.slug).toBe('camel-drop');
+    expect(normalized?.stages[0]?.mintPriceWei).toBe(0n);
+  });
+
+  it('marks an unparseable price as not-free rather than free', () => {
+    const normalized = normalizeDrop({ collection: 'x', stages: [{ stage: 'Public' }] });
+    expect(normalized?.stages[0]?.mintPriceWei).toBe(-1n);
+  });
+
+  it('returns undefined without a slug', () => {
+    expect(normalizeDrop({ stages: [] })).toBeUndefined();
+    expect(normalizeDrop('nope')).toBeUndefined();
+  });
+});
+
+describe('evaluateDrop', () => {
+  it('mints an open, free, public stage', () => {
+    const verdict = evaluateDrop(drop(), opts);
+    expect(verdict.action).toBe('mint');
+    expect(verdict.quantity).toBe(1);
+  });
+
+  it('watches a public stage that has not opened yet', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: 0n, startTime: NOW + 300 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('watch');
+    expect(verdict.reasons[0]).toContain('opens in 300s');
+  });
+
+  it('skips the wrong chain', () => {
+    const verdict = evaluateDrop(drop({ chain: 'base' }), opts);
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('not ethereum');
+  });
+
+  it('skips a priced public stage', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: parseEther('0.01'), startTime: NOW - 1 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('over the 0 wei ceiling');
+  });
+
+  it('skips a stage whose price could not be parsed', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: -1n, startTime: NOW - 1 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('could not be parsed');
+  });
+
+  it('ignores an active allowlist stage', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'allowlist', mintPriceWei: 0n, startTime: NOW - 100 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toBe('no public stage');
+  });
+
+  it('picks the public stage even when an allowlist stage is also present', () => {
+    const verdict = evaluateDrop(
+      drop({
+        stages: [
+          { kind: 'allowlist', mintPriceWei: 0n, startTime: NOW - 500 },
+          { kind: 'public', label: 'Public', mintPriceWei: 0n, startTime: NOW - 5 },
+        ],
+      }),
+      opts,
+    );
+    expect(verdict.action).toBe('mint');
+    expect(verdict.stage?.kind).toBe('public');
+  });
+
+  it('skips a sold-out drop', () => {
+    const verdict = evaluateDrop(drop({ totalSupply: 100, maxSupply: 100 }), opts);
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('sold out');
+  });
+
+  it('mints when supply remains', () => {
+    expect(evaluateDrop(drop({ totalSupply: 99, maxSupply: 100 }), opts).action).toBe('mint');
+  });
+
+  it('skips a stage that has already ended', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: 0n, startTime: NOW - 500, endTime: NOW - 100 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('already ended');
+  });
+
+  it('clamps quantity to maxPerWallet', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: 0n, startTime: NOW - 1, maxPerWallet: 2 }] }),
+      { ...opts, quantity: 5 },
+    );
+    expect(verdict.quantity).toBe(2);
+  });
+
+  it('skips when the wallet limit is zero', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: 0n, startTime: NOW - 1, maxPerWallet: 0 }] }),
+      opts,
+    );
+    expect(verdict.action).toBe('skip');
+    expect(verdict.reasons[0]).toContain('0 per wallet');
+  });
+
+  it('skips a drop with no stages at all', () => {
+    expect(evaluateDrop(drop({ stages: [] }), opts).action).toBe('skip');
+  });
+
+  it('allows a priced stage when the ceiling is raised', () => {
+    const verdict = evaluateDrop(
+      drop({ stages: [{ kind: 'public', mintPriceWei: parseEther('0.01'), startTime: NOW - 1 }] }),
+      { ...opts, maxMintPriceWei: parseEther('0.02') },
+    );
+    expect(verdict.action).toBe('mint');
+  });
+});
+
+describe('isInActiveWindow', () => {
+  const window = { leadSeconds: 120, trailSeconds: 600 };
+
+  it('is true just inside the lead and trail edges', () => {
+    expect(isInActiveWindow(NOW + 120, { ...window, nowSeconds: NOW })).toBe(true);
+    expect(isInActiveWindow(NOW - 600, { ...window, nowSeconds: NOW })).toBe(true);
+  });
+
+  it('is false outside the window on either side', () => {
+    expect(isInActiveWindow(NOW + 121, { ...window, nowSeconds: NOW })).toBe(false);
+    expect(isInActiveWindow(NOW - 601, { ...window, nowSeconds: NOW })).toBe(false);
+  });
+});
+
+describe('stageKey', () => {
+  it('is stable for the same stage and distinct across stages', () => {
+    const a = { kind: 'public' as const, label: 'Public', mintPriceWei: 0n, startTime: 100 };
+    const b = { kind: 'public' as const, label: 'Public', mintPriceWei: 0n, startTime: 200 };
+    expect(stageKey('s', a)).toBe(stageKey('s', a));
+    expect(stageKey('s', a)).not.toBe(stageKey('s', b));
+    expect(stageKey('s', a)).not.toBe(stageKey('other', a));
+  });
+});
