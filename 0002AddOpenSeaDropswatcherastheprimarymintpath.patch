+import { formatGwei, parseGwei } from 'viem';
+import { checkGasBudget } from './budget';
+import type { ChainContext } from './chains';
+import type { Config } from './config';
+import { resolveFees, worstCaseGasCost } from './execute/fees';
+import { log, shortError } from './logger';
+import type { BuiltMintTransaction } from './opensea/drops';
+import type { Store } from './state/store';
+import type { AttemptRecord } from './types';
+
+export interface DropMintDeps {
+  ctx: ChainContext;
+  config: Config;
+  store: Store;
+}
+
+/**
+ * Sends a mint transaction that OpenSea built for us.
+ *
+ * The built transaction is remote input, so it is validated before signing:
+ * a non-zero `value` is refused outright. That keeps the "never pay for a mint"
+ * guarantee even if the API returns a priced stage.
+ */
+export async function executeDropMint(
+  slug: string,
+  tx: BuiltMintTransaction,
+  deps: DropMintDeps,
+): Promise<AttemptRecord> {
+  const { ctx, config, store } = deps;
+  const now = Date.now();
+
+  if (tx.value > config.drops.maxMintPriceWei) {
+    const reason = `built transaction wants ${tx.value} wei, over the ${config.drops.maxMintPriceWei} wei ceiling`;
+    log.warn('refusing drop mint', { slug, reason });
+    return { status: 'rejected', at: now, reason };
+  }
+
+  const fees = await resolveFees(ctx.public, config.mint.maxPriorityFeeGwei);
+
+  // Independent of the priority-fee cap: this is a total gas price ceiling, so
+  // a base-fee spike cannot quietly turn a "free" mint into an expensive one.
+  const gasPriceCap = parseGwei(String(config.drops.maxGasPriceGwei));
+  if (fees.maxFeePerGas > gasPriceCap) {
+    const reason = `gas price ${formatGwei(fees.maxFeePerGas)} gwei exceeds cap ${config.drops.maxGasPriceGwei} gwei`;
+    log.info('skipping drop mint for now', { slug, reason });
+    // Not terminal: the window may still be open when gas settles.
+    return { status: 'skipped', at: now, reason };
+  }
+
+  let gasEstimate: bigint;
+  try {
+    gasEstimate = await ctx.public.estimateGas({
+      account: ctx.account,
+      to: tx.to,
+      data: tx.data,
+      value: tx.value,
+    });
+  } catch (err) {
+    // Sold out, not eligible, or stage closed between poll and send.
+    const reason = `gas estimation failed: ${shortError(err)}`;
+    log.info('drop mint not executable', { slug, reason });
+    return { status: 'rejected', at: now, reason };
+  }
+
+  if (gasEstimate > BigInt(config.mint.maxGasUnits)) {
+    const reason = `gas estimate ${gasEstimate} exceeds maxGasUnits ${config.mint.maxGasUnits}`;
+    return { status: 'rejected', at: now, reason };
+  }
+
+  const gasCost = worstCaseGasCost(gasEstimate, fees);
+  const budget = checkGasBudget(store, ctx.cfg, gasCost);
+  if (!budget.allowed) {
+    log.warn('drop mint over budget', { slug, reason: budget.reason });
+    return { status: 'skipped', at: now, reason: budget.reason };
+  }
+
+  if (config.dryRun || !ctx.wallet || !ctx.canSend) {
+    log.info('DRY RUN — would mint drop', {
+      slug,
+      to: tx.to,
+      value: tx.value,
+      gasEstimate,
+      maxFeePerGas: fees.maxFeePerGas,
+    });
+    return { status: 'dry-run', at: now, label: `drop:${slug}` };
+  }
+
+  const account = ctx.wallet.account;
+  if (!account) return { status: 'failed', at: now, reason: 'wallet has no account' };
+
+  let hash: `0x${string}`;
+  try {
+    hash = await ctx.wallet.sendTransaction({
+      account,
+      chain: ctx.chain,
+      to: tx.to,
+      data: tx.data,
+      value: tx.value,
+      gas: (gasEstimate * 125n) / 100n,
+      maxFeePerGas: fees.maxFeePerGas,
+      maxPriorityFeePerGas: fees.maxPriorityFeePerGas,
+    });
+  } catch (err) {
+    log.warn('drop mint rejected before broadcast', { slug, err: shortError(err) });
+    return { status: 'failed', at: now, label: `drop:${slug}`, reason: shortError(err) };
+  }
+
+  log.info('drop mint submitted', { slug, tx: hash });
+
+  try {
+    const receipt = await ctx.public.waitForTransactionReceipt({
+      hash,
+      confirmations: config.mint.confirmations,
+      timeout: 300_000,
+    });
+    const gasSpent = receipt.gasUsed * receipt.effectiveGasPrice;
+    store.addSpend(ctx.cfg.id, gasSpent);
+
+    if (receipt.status !== 'success') {
+      log.warn('drop mint reverted', { slug, tx: hash });
+      return {
+        status: 'failed',
+        at: Date.now(),
+        label: `drop:${slug}`,
+        txHash: hash,
+        gasCostWei: gasSpent.toString(),
+        reason: 'transaction reverted on chain',
+      };
+    }
+
+    log.info('drop minted', { slug, tx: hash, gasUsed: receipt.gasUsed });
+    return {
+      status: 'minted',
+      at: Date.now(),
+      label: `drop:${slug}`,
+      txHash: hash,
+      gasCostWei: gasSpent.toString(),
+    };
+  } catch (err) {
+    log.warn('could not confirm drop mint', { slug, tx: hash, err: shortError(err) });
+    return {
+      status: 'failed',
+      at: Date.now(),
+      label: `drop:${slug}`,
+      txHash: hash,
+      reason: `unconfirmed: ${shortError(err)}`,
+    };
+  }
+}
diff --git a/src/drops/parser.ts b/src/drops/parser.ts
new file mode 100644
index 0000000..e55c0ae
--- /dev/null
+++ b/src/drops/parser.ts
@@ -0,0 +1,128 @@
+import type { NormalizedDrop, NormalizedStage } from '../opensea/drops';
+
+export type DropAction = 'mint' | 'watch' | 'skip';
+
+export interface DropVerdict {
+  slug: string;
+  action: DropAction;
+  /** The public stage we are acting on, when there is one. */
+  stage?: NormalizedStage;
+  /** Quantity to request, already clamped to the wallet limit. */
+  quantity?: number;
+  reasons: string[];
+}
+
+export interface EvaluateOptions {
+  /** Chain slug we mint on, e.g. "ethereum". */
+  chain: string;
+  /** Hard price ceiling. 0n means free-only. */
+  maxMintPriceWei: bigint;
+  /** Desired quantity, before the per-wallet clamp. */
+  quantity: number;
+  nowSeconds?: number;
+  /** How far ahead of the start time we begin watching. */
+  windowLeadSeconds?: number;
+}
+
+/** A stage identifier for dedupe, stable across polls of the same stage. */
+export function stageKey(slug: string, stage: NormalizedStage): string {
+  return `${slug}:${stage.label ?? stage.kind}:${stage.startTime ?? 0}`;
+}
+
+/**
+ * Decides whether a drop should be minted now, watched until its public stage
+ * opens, or dropped entirely.
+ *
+ * Conservative by construction: anything ambiguous resolves to `skip`. A drop
+ * with no parseable price, no public stage, or the wrong chain never mints.
+ */
+export function evaluateDrop(drop: NormalizedDrop, options: EvaluateOptions): DropVerdict {
+  const now = options.nowSeconds ?? Math.floor(Date.now() / 1000);
+  const lead = options.windowLeadSeconds ?? 120;
+  const reasons: string[] = [];
+  const skip = (reason: string): DropVerdict => ({ slug: drop.slug, action: 'skip', reasons: [reason] });
+
+  if (drop.chain !== undefined && drop.chain !== options.chain) {
+    return skip(`chain is ${drop.chain}, not ${options.chain}`);
+  }
+
+  if (drop.stages.length === 0) {
+    return skip('drop has no mint stages');
+  }
+
+  // Only ever act on a public stage; an active allowlist stage is not ours.
+  const publicStages = drop.stages.filter((s) => s.kind === 'public');
+  if (publicStages.length === 0) {
+    return skip('no public stage');
+  }
+
+  const affordable = publicStages.filter(
+    (s) => s.mintPriceWei >= 0n && s.mintPriceWei <= options.maxMintPriceWei,
+  );
+  if (affordable.length === 0) {
+    // A negative price means "unparseable", which is a different problem from
+    // "too expensive" and should be reported as such.
+    const known = publicStages.map((s) => s.mintPriceWei).filter((p) => p >= 0n);
+    const cheapest = known.length > 0 ? known.reduce((a, b) => (b < a ? b : a)) : undefined;
+    return skip(
+      cheapest === undefined
+        ? 'public stage price could not be parsed'
+        : `public stage costs ${cheapest} wei, over the ${options.maxMintPriceWei} wei ceiling`,
+    );
+  }
+
+  if (
+    drop.maxSupply !== undefined &&
+    drop.totalSupply !== undefined &&
+    drop.totalSupply >= drop.maxSupply
+  ) {
+    return skip(`sold out (${drop.totalSupply}/${drop.maxSupply})`);
+  }
+
+  // Prefer a stage that is open right now; otherwise the soonest one ahead.
+  const live = affordable.find(
+    (s) =>
+      (s.startTime === undefined || now >= s.startTime) &&
+      (s.endTime === undefined || now <= s.endTime),
+  );
+
+  if (live) {
+    if (live.maxPerWallet !== undefined && live.maxPerWallet <= 0) {
+      return skip('public stage allows 0 per wallet');
+    }
+    const quantity = Math.min(options.quantity, live.maxPerWallet ?? options.quantity);
+    if (quantity <= 0) return skip('computed quantity is 0');
+    if (live.startTime === undefined) {
+      reasons.push('stage has no start time; treating as open');
+    }
+    return { slug: drop.slug, action: 'mint', stage: live, quantity, reasons };
+  }
+
+  const upcoming = affordable
+    .filter((s) => s.startTime !== undefined && s.startTime > now)
+    .sort((a, b) => (a.startTime ?? 0) - (b.startTime ?? 0))[0];
+
+  if (upcoming) {
+    const secondsAway = (upcoming.startTime ?? 0) - now;
+    return {
+      slug: drop.slug,
+      action: 'watch',
+      stage: upcoming,
+      reasons: [`public stage opens in ${secondsAway}s`],
+    };
+  }
+
+  return skip('public stage has already ended');
+}
+
+/**
+ * True when a watched drop is close enough to its start time to warrant the
+ * fast poll. Everything else stays on the slow catalog refresh.
+ */
+export function isInActiveWindow(
+  startTimeSeconds: number,
+  options: { nowSeconds?: number; leadSeconds: number; trailSeconds: number },
+): boolean {
+  const now = options.nowSeconds ?? Math.floor(Date.now() / 1000);
+  return now >= startTimeSeconds - options.leadSeconds && now <= startTimeSeconds + options.trailSeconds;
+}
diff --git a/src/opensea/client.ts b/src/opensea/client.ts
new file mode 100644
index 0000000..87b28bc
--- /dev/null
+++ b/src/opensea/client.ts
@@ -0,0 +1,113 @@
+import { log, shortError } from '../logger';
+
+export interface OpenseaClientOptions {
+  apiKey: string;
+  baseUrl?: string;
+  /** Per-request timeout. */
+  timeoutMs?: number;
+  /** Attempts for retryable failures (429 / 5xx / network). */
+  maxAttempts?: number;
+  /** Injectable for tests. */
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export class OpenseaError extends Error {
+  constructor(
+    message: string,
+    readonly status?: number,
+    readonly retryable = false,
+  ) {
+    super(message);
+    this.name = 'OpenseaError';
+  }
+}
+
+const defaultSleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+
+/**
+ * Thin typed wrapper over the OpenSea v2 REST API.
+ *
+ * Rate limiting is the main operational hazard here, so 429 is retried with
+ * exponential backoff and honours `Retry-After` when the server sends it. The
+ * polling loops above are deliberately modest for the same reason.
+ */
+export class OpenseaClient {
+  private readonly baseUrl: string;
+  private readonly timeoutMs: number;
+  private readonly maxAttempts: number;
+  private readonly sleep: (ms: number) => Promise<void>;
+
+  constructor(private readonly options: OpenseaClientOptions) {
+    this.baseUrl = (options.baseUrl ?? 'https://api.opensea.io/api/v2').replace(/\/$/, '');
+    this.timeoutMs = options.timeoutMs ?? 15_000;
+    this.maxAttempts = options.maxAttempts ?? 4;
+    this.sleep = options.sleep ?? defaultSleep;
+  }
+
+  async get<T>(path: string, query: Record<string, string | number | undefined> = {}): Promise<T> {
+    const url = new URL(`${this.baseUrl}${path}`);
+    for (const [key, value] of Object.entries(query)) {
+      if (value !== undefined) url.searchParams.set(key, String(value));
+    }
+    return this.request<T>(url, { method: 'GET' });
+  }
+
+  async post<T>(path: string, body: unknown): Promise<T> {
+    return this.request<T>(new URL(`${this.baseUrl}${path}`), {
+      method: 'POST',
+      body: JSON.stringify(body),
+      headers: { 'content-type': 'application/json' },
+    });
+  }
+
+  private async request<T>(url: URL, init: RequestInit): Promise<T> {
+    let lastError: OpenseaError | undefined;
+
+    for (let attempt = 1; attempt <= this.maxAttempts; attempt += 1) {
+      let res: Response;
+      try {
+        res = await fetch(url, {
+          ...init,
+          headers: {
+            accept: 'application/json',
+            'x-api-key': this.options.apiKey,
+            ...(init.headers ?? {}),
+          },
+          signal: AbortSignal.timeout(this.timeoutMs),
+        });
+      } catch (err) {
+        lastError = new OpenseaError(`network error: ${shortError(err)}`, undefined, true);
+        await this.backoff(attempt, lastError);
+        continue;
+      }
+
+      if (res.ok) {
+        return (await res.json()) as T;
+      }
+
+      const retryable = res.status === 429 || res.status >= 500;
+      const detail = await res.text().catch(() => '');
+      lastError = new OpenseaError(
+        `${res.status} ${res.statusText}${detail ? `: ${detail.slice(0, 200)}` : ''}`,
+        res.status,
+        retryable,
+      );
+
+      if (!retryable) throw lastError;
+
+      // Prefer the server's own pacing when it gives us one.
+      const retryAfter = Number(res.headers.get('retry-after'));
+      const waitMs = Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : undefined;
+      await this.backoff(attempt, lastError, waitMs);
+    }
+
+    throw lastError ?? new OpenseaError('request failed');
+  }
+
+  private async backoff(attempt: number, err: OpenseaError, overrideMs?: number): Promise<void> {
+    if (attempt >= this.maxAttempts) throw err;
+    const waitMs = overrideMs ?? 500 * 2 ** (attempt - 1);
+    log.debug('opensea retry', { attempt, waitMs, err: err.message });
+    await this.sleep(waitMs);
+  }
+}
diff --git a/src/opensea/drops.ts b/src/opensea/drops.ts
new file mode 100644
index 0000000..42ccb79
--- /dev/null
+++ b/src/opensea/drops.ts
@@ -0,0 +1,270 @@
+import { getAddress, isAddress, parseEther, type Hex } from 'viem';
+import type { Address } from '../types';
+import type { OpenseaClient } from './client';
+
+/**
+ * OpenSea's Drops endpoints, in one place so a path change is a one-line edit.
+ *
+ * These follow the shapes documented under "Mint from a Drop". Verify them
+ * against your own API key before relying on the live path — see the README.
+ */
+export const DROP_ENDPOINTS = {
+  list: '/drops',
+  detail: (slug: string) => `/drops/${encodeURIComponent(slug)}`,
+  buildMint: (slug: string) => `/drops/${encodeURIComponent(slug)}/mint`,
+} as const;
+
+export type DropListType = 'upcoming' | 'featured' | 'active';
+
+export type StageKind = 'public' | 'allowlist' | 'unknown';
+
+export interface NormalizedStage {
+  kind: StageKind;
+  label?: string;
+  mintPriceWei: bigint;
+  /** Unix seconds. Undefined when the payload omits it. */
+  startTime?: number;
+  endTime?: number;
+  maxPerWallet?: number;
+}
+
+export interface NormalizedDrop {
+  slug: string;
+  name?: string;
+  chain?: string;
+  contract?: Address;
+  totalSupply?: number;
+  maxSupply?: number;
+  stages: NormalizedStage[];
+}
+
+export interface BuiltMintTransaction {
+  to: Address;
+  data: Hex;
+  value: bigint;
+}
+
+/** Reads the first present key. API responses vary between snake and camel case. */
+function pick(source: Record<string, unknown>, keys: string[]): unknown {
+  for (const key of keys) {
+    const value = source[key];
+    if (value !== undefined && value !== null) return value;
+  }
+  return undefined;
+}
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+/**
+ * Prices show up as wei strings, decimal ETH strings, numbers, or nested
+ * `{ wei }` / `{ value }` objects depending on the endpoint. Normalise to wei.
+ */
+export function parsePriceToWei(raw: unknown): bigint | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  if (typeof raw === 'bigint') return raw;
+
+  const nested = asRecord(raw);
+  if (nested) {
+    return parsePriceToWei(pick(nested, ['wei', 'value', 'amount', 'raw', 'currentPrice']));
+  }
+
+  if (typeof raw === 'number') {
+    if (!Number.isFinite(raw)) return undefined;
+    // A bare number small enough to be ETH is treated as ETH, else as wei.
+    return Number.isInteger(raw) && Math.abs(raw) > 1e6
+      ? BigInt(raw)
+      : parseEther(String(raw));
+  }
+
+  if (typeof raw === 'string') {
+    const trimmed = raw.trim();
+    if (trimmed === '') return undefined;
+    try {
+      // A decimal point means it is denominated in ETH, not wei.
+      return trimmed.includes('.') ? parseEther(trimmed) : BigInt(trimmed);
+    } catch {
+      return undefined;
+    }
+  }
+
+  return undefined;
+}
+
+/** Timestamps arrive as unix seconds, unix millis, or ISO strings. */
+export function parseTimeToSeconds(raw: unknown): number | undefined {
+  if (raw === undefined || raw === null) return undefined;
+
+  if (typeof raw === 'number' && Number.isFinite(raw)) {
+    // Anything past ~year 33658 in seconds is really milliseconds.
+    return raw > 1e12 ? Math.floor(raw / 1000) : Math.floor(raw);
+  }
+
+  if (typeof raw === 'string') {
+    const trimmed = raw.trim();
+    if (trimmed === '') return undefined;
+    if (/^\d+$/.test(trimmed)) return parseTimeToSeconds(Number(trimmed));
+    const parsed = Date.parse(trimmed);
+    return Number.isNaN(parsed) ? undefined : Math.floor(parsed / 1000);
+  }
+
+  return undefined;
+}
+
+export function classifyStage(label: unknown): StageKind {
+  if (typeof label !== 'string') return 'unknown';
+  const normalized = label.toLowerCase();
+  if (normalized.includes('public')) return 'public';
+  if (
+    normalized.includes('allow') ||
+    normalized.includes('presale') ||
+    normalized.includes('vip') ||
+    normalized.includes('private')
+  ) {
+    return 'allowlist';
+  }
+  return 'unknown';
+}
+
+function normalizeStage(raw: unknown): NormalizedStage | undefined {
+  const record = asRecord(raw);
+  if (!record) return undefined;
+
+  const label = pick(record, ['stage', 'stageType', 'stage_type', 'label', 'name', 'type']);
+  const price = parsePriceToWei(
+    pick(record, ['mintPrice', 'mint_price', 'price', 'pricePerToken', 'price_per_token']),
+  );
+
+  return {
+    kind: classifyStage(label),
+    label: typeof label === 'string' ? label : undefined,
+    // Missing price is treated as "not free" so it can never mint by accident.
+    mintPriceWei: price ?? -1n,
+    startTime: parseTimeToSeconds(pick(record, ['startTime', 'start_time', 'startAt', 'start_at'])),
+    endTime: parseTimeToSeconds(pick(record, ['endTime', 'end_time', 'endAt', 'end_at'])),
+    maxPerWallet: toOptionalNumber(
+      pick(record, [
+        'maxPerWallet',
+        'max_per_wallet',
+        'maxMintableByWallet',
+        'maxTotalMintableByWallet',
+        'max_total_mintable_by_wallet',
+        'limit',
+      ]),
+    ),
+  };
+}
+
+function toOptionalNumber(raw: unknown): number | undefined {
+  if (typeof raw === 'number' && Number.isFinite(raw)) return raw;
+  if (typeof raw === 'string' && /^\d+$/.test(raw.trim())) return Number(raw.trim());
+  return undefined;
+}
+
+function toOptionalAddress(raw: unknown): Address | undefined {
+  if (typeof raw === 'string' && isAddress(raw)) return getAddress(raw);
+  const record = asRecord(raw);
+  if (record) {
+    const nested = pick(record, ['address', 'contract', 'contractAddress']);
+    if (typeof nested === 'string' && isAddress(nested)) return getAddress(nested);
+  }
+  return undefined;
+}
+
+/** Tolerant translation of a raw drop payload into the shape we reason about. */
+export function normalizeDrop(raw: unknown): NormalizedDrop | undefined {
+  const record = asRecord(raw);
+  if (!record) return undefined;
+
+  const slugRaw = pick(record, ['collection', 'collectionSlug', 'collection_slug', 'slug']);
+  const slug =
+    typeof slugRaw === 'string'
+      ? slugRaw
+      : ((asRecord(slugRaw)?.slug ?? asRecord(slugRaw)?.collection) as string | undefined);
+  if (typeof slug !== 'string' || slug === '') return undefined;
+
+  const stagesRaw = pick(record, ['stages', 'mintStages', 'mint_stages', 'publicStages']);
+  const stages = Array.isArray(stagesRaw)
+    ? stagesRaw.map(normalizeStage).filter((s): s is NormalizedStage => !!s)
+    : [];
+
+  const contracts = pick(record, ['contracts']);
+  const contract =
+    toOptionalAddress(pick(record, ['contract', 'contractAddress', 'contract_address', 'address'])) ??
+    (Array.isArray(contracts) ? toOptionalAddress(contracts[0]) : undefined);
+
+  const chainRaw = pick(record, ['chain', 'chainIdentifier', 'chain_identifier', 'network']);
+
+  return {
+    slug,
+    name: typeof pick(record, ['name', 'title']) === 'string'
+      ? (pick(record, ['name', 'title']) as string)
+      : undefined,
+    chain: typeof chainRaw === 'string' ? chainRaw.toLowerCase() : undefined,
+    contract,
+    totalSupply: toOptionalNumber(pick(record, ['totalSupply', 'total_supply', 'minted'])),
+    maxSupply: toOptionalNumber(pick(record, ['maxSupply', 'max_supply', 'supply'])),
+    stages,
+  };
+}
+
+interface DropListResponse {
+  drops?: unknown[];
+  results?: unknown[];
+  next?: string;
+}
+
+export async function getDrops(
+  client: OpenseaClient,
+  type: DropListType,
+  limit = 50,
+): Promise<NormalizedDrop[]> {
+  const body = await client.get<DropListResponse>(DROP_ENDPOINTS.list, { type, limit });
+  const entries = body.drops ?? body.results ?? [];
+  return entries.map(normalizeDrop).filter((d): d is NormalizedDrop => !!d);
+}
+
+export async function getDrop(
+  client: OpenseaClient,
+  slug: string,
+): Promise<NormalizedDrop | undefined> {
+  const body = await client.get<Record<string, unknown>>(DROP_ENDPOINTS.detail(slug));
+  // Detail responses sometimes wrap the drop one level down.
+  return normalizeDrop(body.drop ?? body) ?? normalizeDrop(body);
+}
+
+/**
+ * Asks OpenSea to build the mint transaction, then re-validates what came back.
+ *
+ * The response is remote input, so it is never trusted blindly: the caller
+ * refuses anything with a non-zero `value`, which keeps the "never pay" rule
+ * intact even if the API says otherwise.
+ */
+export async function buildDropMintTransaction(
+  client: OpenseaClient,
+  slug: string,
+  minter: Address,
+  quantity: number,
+): Promise<BuiltMintTransaction> {
+  const body = await client.post<Record<string, unknown>>(DROP_ENDPOINTS.buildMint(slug), {
+    minter,
+    quantity,
+  });
+
+  const tx = asRecord(pick(body, ['transaction', 'tx'])) ?? body;
+
+  const to = toOptionalAddress(pick(tx, ['to', 'target', 'contract']));
+  if (!to) throw new Error(`drop ${slug}: mint transaction has no usable "to" address`);
+
+  const dataRaw = pick(tx, ['data', 'calldata', 'input']);
+  if (typeof dataRaw !== 'string' || !dataRaw.startsWith('0x')) {
+    throw new Error(`drop ${slug}: mint transaction has no usable calldata`);
+  }
+
+  const value = parsePriceToWei(pick(tx, ['value', 'wei', 'amount'])) ?? 0n;
+
+  return { to, data: dataRaw as Hex, value };
+}
