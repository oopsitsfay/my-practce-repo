diff --git a/tests/watcher.integration.test.ts b/tests/watcher.integration.test.ts
new file mode 100644
index 0000000..0f0000b
--- /dev/null
+++ b/tests/watcher.integration.test.ts
@@ -0,0 +1,318 @@
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { encodeFunctionData, parseAbi, toFunctionSelector } from 'viem';
+import { afterEach, describe, expect, it } from 'vitest';
+import { makeChainContext } from '../src/chains';
+import type { Config } from '../src/config';
+import { OpenseaClient } from '../src/opensea/client';
+import { buildDropMintTransaction, getDrop, getDrops } from '../src/opensea/drops';
+import { Store } from '../src/state/store';
+import type { Address } from '../src/types';
+import { DropWatcher } from '../src/watcher';
+import { testChain, testConfig } from './helpers/config';
+import { startMockNode, type MockNode } from './helpers/mockNode';
+import { startMockOpensea, type MockOpensea } from './helpers/mockOpensea';
+
+const SEADROP = '0x1234567890123456789012345678901234567890' as Address;
+const MINTER = '0x000000000000000000000000000000000000dEaD' as Address;
+const SLUG = 'free-public-drop';
+
+const MINT_ABI = parseAbi(['function mintPublic(address nft, uint256 quantity)']);
+const MINT_DATA = encodeFunctionData({
+  abi: MINT_ABI,
+  functionName: 'mintPublic',
+  args: [SEADROP, 1n],
+});
+const MINT_SELECTOR = toFunctionSelector('mintPublic(address,uint256)');
+
+const NOW_SECONDS = () => Math.floor(Date.now() / 1000);
+
+function publicDrop(over: Record<string, unknown> = {}) {
+  return {
+    collection: SLUG,
+    name: 'Free Public Drop',
+    chain: 'ethereum',
+    contract: SEADROP,
+    totalSupply: 5,
+    maxSupply: 1000,
+    stages: [{ stage: 'Public', mintPrice: '0', startTime: NOW_SECONDS() - 5, maxPerWallet: 3 }],
+    ...over,
+  };
+}
+
+function config(over: Partial<Config> = {}): Config {
+  const dir = mkdtempSync(join(tmpdir(), 'automint-watch-'));
+  const base = testConfig();
+  return testConfig({
+    statePath: join(dir, 'state.json'),
+    killSwitchPath: join(dir, 'STOP'),
+    drops: { ...base.drops, enabled: true, chainId: 31337 },
+    ...over,
+  });
+}
+
+function makeWatcher(
+  node: MockNode,
+  os: MockOpensea,
+  over: Partial<Config> = {},
+): { watcher: DropWatcher; store: Store; config: Config } {
+  const cfg = config(over);
+  const store = Store.open(cfg.statePath);
+  const ctx = makeChainContext(testChain(node.url), {});
+  const client = new OpenseaClient({
+    apiKey: 'test-key',
+    baseUrl: os.url,
+    sleep: async () => {},
+  });
+  return { watcher: new DropWatcher({ ctx, config: cfg, store, client }), store, config: cfg };
+}
+
+let node: MockNode | undefined;
+let os: MockOpensea | undefined;
+
+afterEach(async () => {
+  await node?.close();
+  await os?.close();
+  node = undefined;
+  os = undefined;
+});
+
+async function bootNode() {
+  return startMockNode({
+    contract: SEADROP,
+    interfaceId: '0x80ac58cd',
+    mintableSelectors: [MINT_SELECTOR],
+    simulationRecipient: MINTER,
+  });
+}
+
+const MINT_TX = { transaction: { to: SEADROP, data: MINT_DATA, value: '0' } };
+
+describe('OpenseaClient', () => {
+  it('sends the API key and retries 429 with Retry-After', async () => {
+    os = await startMockOpensea({
+      lists: { upcoming: [publicDrop()] },
+      rateLimitFirst: 2,
+      retryAfterSeconds: 1,
+    });
+
+    const client = new OpenseaClient({ apiKey: 'test-key', baseUrl: os.url, sleep: async () => {} });
+    const drops = await getDrops(client, 'upcoming');
+
+    expect(drops).toHaveLength(1);
+    expect(os.apiKeys.every((k) => k === 'test-key')).toBe(true);
+    // Two 429s then success.
+    expect(os.requests).toHaveLength(3);
+  });
+
+  it('gives up after maxAttempts and throws', async () => {
+    os = await startMockOpensea({ lists: { upcoming: [] }, rateLimitFirst: 99 });
+    const client = new OpenseaClient({
+      apiKey: 'k',
+      baseUrl: os.url,
+      maxAttempts: 2,
+      sleep: async () => {},
+    });
+    await expect(getDrops(client, 'upcoming')).rejects.toThrow(/429/);
+  });
+
+  it('does not retry a 404', async () => {
+    os = await startMockOpensea({});
+    const client = new OpenseaClient({ apiKey: 'k', baseUrl: os.url, sleep: async () => {} });
+    await expect(getDrop(client, 'nope')).rejects.toThrow(/404/);
+    expect(os.requests).toHaveLength(1);
+  });
+});
+
+describe('buildDropMintTransaction', () => {
+  it('extracts to/data/value from the built transaction', async () => {
+    os = await startMockOpensea({ mintTx: { [SLUG]: MINT_TX } });
+    const client = new OpenseaClient({ apiKey: 'k', baseUrl: os.url, sleep: async () => {} });
+
+    const tx = await buildDropMintTransaction(client, SLUG, MINTER, 1);
+
+    expect(tx.to).toBe(SEADROP);
+    expect(tx.data).toBe(MINT_DATA);
+    expect(tx.value).toBe(0n);
+    expect(os.postBodies[0]).toEqual({ minter: MINTER, quantity: 1 });
+  });
+
+  it('rejects a response with no usable calldata', async () => {
+    os = await startMockOpensea({ mintTx: { [SLUG]: { to: SEADROP } } });
+    const client = new OpenseaClient({ apiKey: 'k', baseUrl: os.url, sleep: async () => {} });
+    await expect(buildDropMintTransaction(client, SLUG, MINTER, 1)).rejects.toThrow(/calldata/);
+  });
+});
+
+describe('DropWatcher', () => {
+  it('mints an already-open free public drop and dedupes by slug', async () => {
+    node = await bootNode();
+    os = await startMockOpensea({
+      lists: { upcoming: [publicDrop()] },
+      details: { [SLUG]: publicDrop() },
+      mintTx: { [SLUG]: MINT_TX },
+    });
+
+    const { watcher, store } = makeWatcher(node, os);
+    const stats = await watcher.tick();
+
+    expect(stats.dryRun).toBe(1);
+    expect(store.isSlugMinted(SLUG)).toBe(true);
+
+    // Second tick must not mint again.
+    const again = await watcher.tick(Date.now() + 60_001);
+    expect(again.dryRun).toBe(0);
+  });
+
+  it('requests exactly the clamped quantity', async () => {
+    node = await bootNode();
+    os = await startMockOpensea({
+      lists: { upcoming: [publicDrop()] },
+      mintTx: { [SLUG]: MINT_TX },
+    });
+
+    const base = testConfig();
+    const { watcher } = makeWatcher(node, os, {
+      drops: { ...base.drops, enabled: true, chainId: 31337, quantity: 10 },
+    });
+    await watcher.tick();
+
+    // maxPerWallet is 3, so 10 is clamped down.
+    expect(os.postBodies[0]).toEqual({ minter: MINTER, quantity: 3 });
+  });
+
+  it('watches an upcoming drop instead of minting it', async () => {
+    node = await bootNode();
+    const future = publicDrop({
+      stages: [{ stage: 'Public', mintPrice: '0', startTime: NOW_SECONDS() + 3600 }],
+    });
+    os = await startMockOpensea({ lists: { upcoming: [future] }, mintTx: { [SLUG]: MINT_TX } });
+
+    const { watcher, store } = makeWatcher(node, os);
+    const stats = await watcher.tick();
+
+    expect(stats.dryRun).toBe(0);
+    expect(stats.watching).toBe(1);
+    expect(store.listWatch()[0]?.slug).toBe(SLUG);
+    // Too far out to be polled yet.
+    expect(stats.polled).toBe(0);
+  });
+
+  it('fast-polls a drop inside its go-live window and mints when it opens', async () => {
+    node = await bootNode();
+    // Starts 30s out: inside the 120s lead window, so it gets fast-polled.
+    const soon = publicDrop({
+      stages: [{ stage: 'Public', mintPrice: '0', startTime: NOW_SECONDS() + 30 }],
+    });
+    os = await startMockOpensea({
+      lists: { upcoming: [soon] },
+      // Detail says it is already open.
+      details: { [SLUG]: publicDrop() },
+      mintTx: { [SLUG]: MINT_TX },
+    });
+
+    const { watcher } = makeWatcher(node, os);
+    const stats = await watcher.tick();
+
+    expect(stats.polled).toBe(1);
+    expect(stats.dryRun).toBe(1);
+    expect(os.requests).toContain(`GET /drops/${SLUG}`);
+  });
+
+  it('never mints a priced drop', async () => {
+    node = await bootNode();
+    const priced = publicDrop({
