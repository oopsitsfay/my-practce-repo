+import { createServer, type Server } from 'node:http';
+
+export interface MockOpenseaOptions {
+  /** Drop payloads keyed by list type, returned verbatim from /drops. */
+  lists?: Record<string, unknown[]>;
+  /** Drop detail payloads keyed by slug, returned from /drops/{slug}. */
+  details?: Record<string, unknown>;
+  /** Built mint transactions keyed by slug, returned from /drops/{slug}/mint. */
+  mintTx?: Record<string, unknown>;
+  /** Fail this many requests with 429 before succeeding. */
+  rateLimitFirst?: number;
+  /** Seconds to advertise in Retry-After on those 429s. */
+  retryAfterSeconds?: number;
+}
+
+export interface MockOpensea {
+  url: string;
+  close: () => Promise<void>;
+  /** "<METHOD> <path>" for every request received. */
+  requests: string[];
+  /** API keys seen, so tests can assert the header is sent. */
+  apiKeys: string[];
+  /** Bodies of POST requests, parsed. */
+  postBodies: unknown[];
+}
+
+/** Stands in for api.opensea.io/api/v2 so the client is exercised for real. */
+export async function startMockOpensea(options: MockOpenseaOptions = {}): Promise<MockOpensea> {
+  const requests: string[] = [];
+  const apiKeys: string[] = [];
+  const postBodies: unknown[] = [];
+  let rateLimitsLeft = options.rateLimitFirst ?? 0;
+
+  const server: Server = createServer((req, res) => {
+    let body = '';
+    req.on('data', (chunk) => {
+      body += chunk;
+    });
+    req.on('end', () => {
+      const url = new URL(req.url ?? '/', 'http://localhost');
+      requests.push(`${req.method} ${url.pathname}`);
+      const key = req.headers['x-api-key'];
+      if (typeof key === 'string') apiKeys.push(key);
+
+      const send = (status: number, payload: unknown, headers: Record<string, string> = {}) => {
+        res.writeHead(status, { 'content-type': 'application/json', ...headers });
+        res.end(JSON.stringify(payload));
+      };
+
+      if (rateLimitsLeft > 0) {
+        rateLimitsLeft -= 1;
+        const headers: Record<string, string> = options.retryAfterSeconds
+          ? { 'retry-after': String(options.retryAfterSeconds) }
+          : {};
+        send(429, { error: 'rate limited' }, headers);
+        return;
+      }
+
+      // POST /drops/{slug}/mint
+      const mintMatch = url.pathname.match(/^\/drops\/([^/]+)\/mint$/);
+      if (req.method === 'POST' && mintMatch) {
+        const slug = decodeURIComponent(mintMatch[1] ?? '');
+        postBodies.push(body ? JSON.parse(body) : undefined);
+        const tx = options.mintTx?.[slug];
+        if (!tx) {
+          send(404, { error: `no mint tx for ${slug}` });
+          return;
+        }
+        send(200, tx);
+        return;
+      }
+
+      // GET /drops/{slug}
+      const detailMatch = url.pathname.match(/^\/drops\/([^/]+)$/);
+      if (req.method === 'GET' && detailMatch) {
+        const slug = decodeURIComponent(detailMatch[1] ?? '');
+        const detail = options.details?.[slug];
+        if (!detail) {
+          send(404, { error: `no such drop ${slug}` });
+          return;
+        }
+        send(200, detail);
+        return;
+      }
+
+      // GET /drops?type=...
+      if (req.method === 'GET' && url.pathname === '/drops') {
+        const type = url.searchParams.get('type') ?? 'upcoming';
+        send(200, { drops: options.lists?.[type] ?? [] });
+        return;
+      }
+
+      send(404, { error: 'not found' });
+    });
+  });
+
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const addr = server.address();
+  if (addr === null || typeof addr === 'string') throw new Error('mock opensea failed to bind');
+
+  return {
+    url: `http://127.0.0.1:${addr.port}`,
+    requests,
+    apiKeys,
+    postBodies,
+    close: () =>
+      new Promise<void>((resolve, reject) => server.close((err) => (err ? reject(err) : resolve()))),
+  };
+}
