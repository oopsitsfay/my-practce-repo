diff --git a/src/watcher.ts b/src/watcher.ts
new file mode 100644
index 0000000..25e80f9
--- /dev/null
+++ b/src/watcher.ts
@@ -0,0 +1,224 @@
+import { killSwitchEngaged } from './budget';
+import type { ChainContext } from './chains';
+import type { Config } from './config';
+import { evaluateDrop, isInActiveWindow, stageKey, type DropVerdict } from './drops/parser';
+import { executeDropMint } from './dropMinter';
+import { log, shortError } from './logger';
+import type { OpenseaClient } from './opensea/client';
+import { buildDropMintTransaction, getDrop, getDrops } from './opensea/drops';
+import type { Store } from './state/store';
+
+export interface WatcherDeps {
+  ctx: ChainContext;
+  config: Config;
+  store: Store;
+  client: OpenseaClient;
+}
+
+export interface WatcherStats {
+  cataloged: number;
+  watching: number;
+  polled: number;
+  minted: number;
+  dryRun: number;
+  skipped: number;
+  rejected: number;
+}
+
+const EMPTY_STATS: WatcherStats = {
+  cataloged: 0,
+  watching: 0,
+  polled: 0,
+  minted: 0,
+  dryRun: 0,
+  skipped: 0,
+  rejected: 0,
+};
+
+/**
+ * Two-tier poller for OpenSea Drops.
+ *
+ * The slow tier refreshes the catalog and maintains a watchlist; the fast tier
+ * only runs for drops whose public stage is about to open. That keeps request
+ * volume low enough to stay well inside the API's rate limits while still
+ * reacting within a few seconds of go-live.
+ */
+export class DropWatcher {
+  private lastCatalogAt = 0;
+
+  constructor(private readonly deps: WatcherDeps) {}
+
+  /** One tick. Safe to call as often as the caller likes; it self-paces. */
+  async tick(now = Date.now()): Promise<WatcherStats> {
+    const stats = { ...EMPTY_STATS };
+    const { config } = this.deps;
+
+    if (now - this.lastCatalogAt >= config.drops.catalogPollMs) {
+      this.lastCatalogAt = now;
+      await this.refreshCatalog(stats, now);
+    }
+
+    await this.pollActiveWindows(stats, now);
+
+    stats.watching = this.deps.store.listWatch().length;
+    return stats;
+  }
+
+  /** Slow tier: pull the catalog and decide what to watch or mint immediately. */
+  private async refreshCatalog(stats: WatcherStats, now: number): Promise<void> {
+    const { config, client, store } = this.deps;
+    const nowSeconds = Math.floor(now / 1000);
+
+    const seen = new Map<string, DropVerdict>();
+
+    for (const type of config.drops.listTypes) {
+      let drops;
+      try {
+        drops = await getDrops(client, type, config.discovery.opensea.limit);
+      } catch (err) {
+        log.warn('drop catalog fetch failed', { type, err: shortError(err) });
+        continue;
+      }
+
+      stats.cataloged += drops.length;
+
+      for (const drop of drops) {
+        if (seen.has(drop.slug)) continue;
+        if (store.isSlugMinted(drop.slug)) continue;
+
+        const verdict = evaluateDrop(drop, {
+          chain: config.drops.chain,
+          maxMintPriceWei: config.drops.maxMintPriceWei,
+          quantity: config.drops.quantity,
+          nowSeconds,
+          windowLeadSeconds: config.drops.windowLeadSeconds,
+        });
+        seen.set(drop.slug, verdict);
+
+        if (verdict.action === 'watch' && verdict.stage?.startTime !== undefined) {
+          store.upsertWatch({
+            slug: drop.slug,
+            name: drop.name,
+            startTime: verdict.stage.startTime,
+            contract: drop.contract,
+            updatedAt: now,
+          });
+          log.debug('watching drop', { slug: drop.slug, opensIn: verdict.stage.startTime - nowSeconds });
+        } else if (verdict.action === 'mint') {
+          // Already open when we found it — go straight to the mint path.
+          await this.attemptMint(drop.slug, verdict, stats, now);
+        } else {
+          store.removeWatch(drop.slug);
+          log.debug('drop skipped', { slug: drop.slug, reasons: verdict.reasons });
+        }
+      }
+    }
+
+    const pruned = store.pruneWatchlist(nowSeconds - config.drops.windowTrailSeconds);
+    if (pruned > 0) log.debug('pruned expired watch entries', { pruned });
+  }
+
+  /** Fast tier: only drops inside their go-live window get polled. */
+  private async pollActiveWindows(stats: WatcherStats, now: number): Promise<void> {
+    const { config, client, store } = this.deps;
+    const nowSeconds = Math.floor(now / 1000);
+
+    const active = store.listWatch().filter((entry) =>
+      isInActiveWindow(entry.startTime, {
+        nowSeconds,
+        leadSeconds: config.drops.windowLeadSeconds,
+        trailSeconds: config.drops.windowTrailSeconds,
+      }),
+    );
+
+    for (const entry of active) {
+      if (store.isSlugMinted(entry.slug)) {
+        store.removeWatch(entry.slug);
+        continue;
+      }
+
+      stats.polled += 1;
+      let drop;
+      try {
+        drop = await getDrop(client, entry.slug);
+      } catch (err) {
+        log.debug('drop detail fetch failed', { slug: entry.slug, err: shortError(err) });
+        continue;
+      }
+      if (!drop) continue;
+
+      const verdict = evaluateDrop(drop, {
+        chain: config.drops.chain,
+        maxMintPriceWei: config.drops.maxMintPriceWei,
+        quantity: config.drops.quantity,
+        nowSeconds,
+        windowLeadSeconds: config.drops.windowLeadSeconds,
+      });
+
+      if (verdict.action === 'mint') {
+        await this.attemptMint(entry.slug, verdict, stats, now);
+      } else if (verdict.action === 'skip') {
+        log.info('dropping from watchlist', { slug: entry.slug, reasons: verdict.reasons });
+        store.removeWatch(entry.slug);
+      } else if (verdict.stage?.startTime !== undefined) {
+        // Start time moved; keep the watchlist in sync with the API.
+        store.upsertWatch({ ...entry, startTime: verdict.stage.startTime, updatedAt: now });
+      }
+    }
+  }
+
+  private async attemptMint(
+    slug: string,
+    verdict: DropVerdict,
+    stats: WatcherStats,
+    now: number,
+  ): Promise<void> {
+    const { config, client, store, ctx } = this.deps;
+
+    if (killSwitchEngaged(config.killSwitchPath)) {
+      log.warn('kill switch present — not minting drop', { slug });
+      return;
+    }
+    if (store.isSlugMinted(slug)) return;
+
+    // One attempt per stage window, so a reverting drop cannot be retried in a
+    // tight loop for the whole window.
+    const key = verdict.stage ? stageKey(slug, verdict.stage) : `${slug}:unknown`;
+    if (store.hasAttemptedStage(key)) {
+      log.debug('stage already attempted', { slug, key });
+      return;
+    }
+
+    const quantity = verdict.quantity ?? config.drops.quantity;
+    log.info('public free stage open', { slug, quantity, reasons: verdict.reasons });
+
+    let tx;
+    try {
+      tx = await buildDropMintTransaction(client, slug, ctx.account, quantity);
+    } catch (err) {
+      log.warn('could not build drop mint transaction', { slug, err: shortError(err) });
+      return;
+    }
+
+    store.markStageAttempted(key, now);
+    const record = await executeDropMint(slug, tx, { ctx, config, store });
+
+    if (record.status === 'minted' || record.status === 'dry-run') {
+      store.recordSlugMint(slug, record);
+      store.removeWatch(slug);
+      if (record.status === 'minted') stats.minted += 1;
+      else stats.dryRun += 1;
+      return;
+    }
+
+    if (record.status === 'skipped') {
+      // Transient (gas cap, budget): reopen the stage for a later retry while
+      // the window is still open.
+      stats.skipped += 1;
+      store.clearStageAttempt(key);
+      return;
+    }
+
+    stats.rejected += 1;
+  }
+}
diff --git a/tests/dropParser.test.ts b/tests/dropParser.test.ts
